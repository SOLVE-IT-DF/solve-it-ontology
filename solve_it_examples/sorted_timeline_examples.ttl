###  Position 11: PHOTO.JPG accessed (2025-11-04, whole day) - TIED with DRAFT.DOC and BUDGET.XLS
:ste-file005-accessed rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "PHOTO.JPG accessed (position 11, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file005-accessed ;
    solveit-observable:sortPosition "11"^^xsd:nonNegativeInteger .

#################################################################
#    The SortedTimeline (produced by Step 3: DFT-xxxx)
#    Links to both the original TimelineEntries (via inherited
#    hasTimelineEntry) and the SortedTimelineEntry wrappers
#    (via hasSortedTimelineEntry).
#################################################################

:fatSortedTimeline001 rdf:type solveit-observable:SortedTimeline ;
    rdfs:label "FAT timestamp timeline (sorted, 15 entries)"@en ;
    solveit-observable:hasTimelineEntry :te-file001-created ,
                                        :te-file001-modified ,
                                        :te-file001-accessed ,
                                        :te-file002-created ,
                                        :te-file002-modified ,
                                        :te-file002-accessed ,
                                        :te-file003-created ,
                                        :te-file003-modified ,
                                        :te-file003-accessed ,
                                        :te-file004-created ,
                                        :te-file004-modified ,
                                        :te-file004-accessed ,
                                        :te-file005-created ,
                                        :te-file005-modified ,
                                        :te-file005-accessed ;
    solveit-observable:hasSortedTimelineEntry :ste-file001-created ,
                                              :ste-file001-modified ,
                                              :ste-file001-accessed ,
                                              :ste-file002-created ,
                                              :ste-file002-modified ,
                                              :ste-file002-accessed ,
                                              :ste-file003-created ,
                                              :ste-file003-modified ,
                                              :ste-file003-accessed ,
                                              :ste-file004-created ,
                                              :ste-file004-modified ,
                                              :ste-file004-accessed ,
                                              :ste-file005-created ,
                                              :ste-file005-modified ,
                                              :ste-file005-accessed ;
    rdfs:comment "Sorted timeline of all 15 FAT timestamp entries from the suspect USB drive. Three sets of ties: (1) NOTES.TXT and DRAFT.DOC modified at position 5 (same 2s value), (2) README.TXT and NOTES.TXT accessed at position 10 (same day 2025-11-03), (3) DRAFT.DOC, BUDGET.XLS, and PHOTO.JPG accessed at position 11 (same day 2025-11-04). Accessed date ranges are placed at the end of their respective days."@en .

#################################################################
#    Step 4: DFT-1182 Filtered SortedTimeline
#
#    Filter window: 2025-11-03T10:20:00 to 2025-11-03T10:23:00
#    (centred around DRAFT.DOC creation at 10:20:41.840)
#
#    Entries captured by the filter:
#    Pos  Entry                  Value           Resolution
#    ---  ---------------------  --------------  ----------
#     1   NOTES.TXT created      10:20:41.150    10ms
#     2   DRAFT.DOC created      10:20:41.840    10ms
#     3   NOTES.TXT modified     10:22:16        2s  (TIED)
#     3   DRAFT.DOC modified     10:22:16        2s  (TIED)
#
#    This filtered timeline is itself a SortedTimeline. It reuses
#    the SAME TimelineEntry instances from the full timeline, but
#    creates NEW SortedTimelineEntry wrappers with fresh positions
#    (re-numbered 1-3 for the filtered set).
#################################################################

###  Filtered SortedTimelineEntry wrappers (new positions for filtered set)

:fste-file002-created rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "NOTES.TXT created (filtered position 1)"@en ;
    solveit-observable:referencesTimelineEntry :te-file002-created ;
    solveit-observable:sortPosition "1"^^xsd:nonNegativeInteger .

:fste-file003-created rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "DRAFT.DOC created (filtered position 2)"@en ;
    solveit-observable:referencesTimelineEntry :te-file003-created ;
    solveit-observable:sortPosition "2"^^xsd:nonNegativeInteger .

:fste-file002-modified rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "NOTES.TXT modified (filtered position 3, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file002-modified ;
    solveit-observable:sortPosition "3"^^xsd:nonNegativeInteger .

:fste-file003-modified rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "DRAFT.DOC modified (filtered position 3, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file003-modified ;
    solveit-observable:sortPosition "3"^^xsd:nonNegativeInteger .

###  The filtered SortedTimeline

:filteredSortedTimeline001 rdf:type solveit-observable:SortedTimeline ;
    rdfs:label "Filtered timeline around DRAFT.DOC creation (4 entries)"@en ;
    solveit-observable:hasTimelineEntry :te-file002-created ,
                                        :te-file003-created ,
                                        :te-file002-modified ,
                                        :te-file003-modified ;
    solveit-observable:hasSortedTimelineEntry :fste-file002-created ,
                                              :fste-file003-created ,
                                              :fste-file002-modified ,
                                              :fste-file003-modified ;
    rdfs:comment "Filtered sorted timeline containing only entries within the window 10:20:00-10:23:00 on 2025-11-03, centred around DRAFT.DOC's creation. Shows that NOTES.TXT was created 690ms before DRAFT.DOC (distinguishable at 10ms resolution), but both files were modified within the same 2-second FAT window (tied at position 3). This pattern is consistent with two files being saved in rapid succession."@en .
