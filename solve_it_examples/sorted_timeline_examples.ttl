@prefix : <https://ontology.solveit-df.org/solveit/examples/> .
@prefix solveit-core: <https://ontology.solveit-df.org/solveit/core/> .
@prefix solveit-observable: <https://ontology.solveit-df.org/solveit/observable/> .
@prefix solveit-data: <https://ontology.solveit-df.org/solveit/data/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@prefix uco-tool: <https://ontology.unifiedcyberontology.org/uco/tool/> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@base <https://ontology.solveit-df.org/solveit/examples/> .

#################################################################
#    WORK IN PROGRESS - under active development
#
#    SOLVE-IT Timeline Examples - Full FAT32 Workflow
#
#    Demonstrates the complete timeline workflow on a FAT32 USB
#    drive containing 5 files:
#
#    1. DFT-1060: Enumerate files from the filesystem
#    2. DFT-1052: Generate timeline entries for ALL FAT timestamps
#       (created, modified, accessed) per file = 15 entries total
#    3. DFT-xxxx: Sort the timeline into a SortedTimeline with
#       tied positions where timestamps are indistinguishable
#    4. DFT-1182: Filter the sorted timeline around a specific
#       event (DRAFT.DOC creation) to produce a smaller timeline
#
#    FAT Timestamp Resolutions:
#    - Created:  10ms (2-second base + hundredths byte)
#    - Modified: 2s
#    - Accessed: 1 day (date only, no time component)
#
#    For accessed timestamps, DateTimeRange is used (not
#    DateTimeStamp) because 1-day resolution means the access
#    happened sometime during the day, not at a specific point.
#################################################################

<https://ontology.solveit-df.org/solveit/examples/sorted-timeline> rdf:type owl:Ontology ;
    owl:versionIRI <https://ontology.solveit-df.org/solveit/examples/sorted-timeline/0.2.0> ;
    owl:imports <https://ontology.solveit-df.org/solveit/observable> ,
                <https://ontology.solveit-df.org/solveit/data> ;
    rdfs:label "SOLVE-IT Sorted Timeline Examples"@en ;
    rdfs:comment "Full workflow example: enumerate 5 files from a FAT32 USB drive, generate a 15-entry timeline (created/modified/accessed per file), sort it with tied positions, then filter around a specific event. Demonstrates DateTimeStamp (for created and modified) and DateTimeRange (for accessed dates) with FAT-specific resolutions."@en .

#################################################################
#    Techniques referenced from the SOLVE-IT Knowledge Base:
#    https://ontology.solveit-df.org/data/solve-it-kb.ttl
#    - solveit-data:techniqueDFT-1060 (Enumerate allocated files)
#    - solveit-data:techniqueDFT-1052 (Timeline generation)
#    - solveit-data:techniqueDFT-xxxx (Sort timeline) [placeholder]
#    - solveit-data:techniqueDFT-1182 (Filter timeline)
#################################################################

#################################################################
#    Supporting objects for investigative actions
#################################################################

:examiner-john-smith rdf:type uco-identity:Person ;
    rdfs:label "John Smith"@en ;
    uco-core:name "John Smith" .

:tool-acme-filesystem-parser rdf:type uco-tool:AnalyticTool ;
    rdfs:label "ACME file system parser"@en ;
    uco-core:name "ACME file system parser" ;
    uco-tool:version "1.0" .

:tool-plaso rdf:type uco-tool:AnalyticTool ;
    rdfs:label "Plaso"@en ;
    uco-core:name "Plaso" ;
    uco-tool:version "20241201" ;
    rdfs:comment "Log2timeline/Plaso - timeline generation tool."@en .

:tool-timeline-analyser rdf:type uco-tool:AnalyticTool ;
    rdfs:label "Timeline Analyser"@en ;
    uco-core:name "Timeline Analyser" ;
    uco-tool:version "2.1" ;
    rdfs:comment "Tool for sorting and filtering forensic timelines."@en .

:filesystem-a3c71d90-4e8b-4a1f-b2d6-9f0e3c5a7b12 rdf:type uco-observable:FileSystem ;
    rdfs:label "FAT32 filesystem on suspect USB drive"@en .

:fileset-a3c71d90-4e8b-4a1f-b2d6-9f0e3c5a7b12 rdf:type solveit-observable:FileSet ;
    rdfs:label "Enumerated files from FAT32 suspect USB drive"@en .

#################################################################
#    Four-step provenance chain
#
#    Step 1: DFT-1060 enumerates files from the filesystem
#    Step 2: DFT-1052 generates timeline entries (15 total)
#    Step 3: DFT-xxxx sorts the timeline (tied positions)
#    Step 4: DFT-1182 filters around DRAFT.DOC creation time
#################################################################

###  Step 1: DFT-1060 Enumerate allocated files
:enumerateFilesAction003 rdf:type solveit-core:SolveitInvestigativeAction ;
    uco-core:name "enumerate-files" ;
    uco-core:description "Enumeration of allocated files from FAT32 suspect USB drive" ;
    solveit-core:usedTechnique solveit-data:techniqueDFT-1060 ;
    uco-action:performer :examiner-john-smith ;
    uco-action:instrument :tool-acme-filesystem-parser ;
    uco-action:startTime "2026-02-10T09:00:00Z"^^xsd:dateTime ;
    uco-action:endTime "2026-02-10T09:02:00Z"^^xsd:dateTime ;
    uco-action:object :filesystem-a3c71d90-4e8b-4a1f-b2d6-9f0e3c5a7b12 ;
    uco-action:result :fileset-a3c71d90-4e8b-4a1f-b2d6-9f0e3c5a7b12 ;
    rdfs:comment "DFT-1060: Enumerate allocated files - extracts 5 file objects with FAT timestamps from the suspect USB drive."@en .

###  Step 2: DFT-1052 Timeline generation - creates 15 timeline entries (3 per file)
:timelineGenerationAction003 rdf:type solveit-core:SolveitInvestigativeAction ;
    uco-core:name "generate-timeline" ;
    uco-core:description "Generation of forensic timeline from all FAT timestamps (created, modified, accessed) for 5 files" ;
    solveit-core:usedTechnique solveit-data:techniqueDFT-1052 ;
    uco-action:performer :examiner-john-smith ;
    uco-action:instrument :tool-plaso ;
    uco-action:startTime "2026-02-10T09:02:00Z"^^xsd:dateTime ;
    uco-action:endTime "2026-02-10T09:03:00Z"^^xsd:dateTime ;
    uco-action:object :fatSortFile001 ,
                      :fatSortFile002 ,
                      :fatSortFile003 ,
                      :fatSortFile004 ,
                      :fatSortFile005 ;
    uco-action:result :te-file001-created ,
                      :te-file001-modified ,
                      :te-file001-accessed ,
                      :te-file002-created ,
                      :te-file002-modified ,
                      :te-file002-accessed ,
                      :te-file003-created ,
                      :te-file003-modified ,
                      :te-file003-accessed ,
                      :te-file004-created ,
                      :te-file004-modified ,
                      :te-file004-accessed ,
                      :te-file005-created ,
                      :te-file005-modified ,
                      :te-file005-accessed ,
                      :fatTimeline001 ;
    rdfs:comment "DFT-1052: Timeline generation - creates 15 TimelineEntries (created/modified/accessed for each of 5 files) and assembles them into an unsorted Timeline. Created and modified times become DateTimeStamp values; accessed dates become DateTimeRange values (whole-day intervals)."@en .

###  Step 3: DFT-xxxx Sort timeline - produces SortedTimeline with tied positions
:timelineSortAction001 rdf:type solveit-core:SolveitInvestigativeAction ;
    uco-core:name "sort-timeline" ;
    uco-core:description "Chronological sorting of 15-entry FAT timestamp timeline, assigning positions with ties where timestamps are indistinguishable" ;
    solveit-core:usedTechnique solveit-data:techniqueDFT-1052 ;
    uco-action:performer :examiner-john-smith ;
    uco-action:instrument :tool-timeline-analyser ;
    uco-action:startTime "2026-02-10T09:03:00Z"^^xsd:dateTime ;
    uco-action:endTime "2026-02-10T09:03:30Z"^^xsd:dateTime ;
    uco-action:object :fatTimeline001 ;
    uco-action:result :fatSortedTimeline001 ;
    rdfs:comment "DFT-xxxx: Sort timeline - orders 15 entries chronologically. Point timestamps (DateTimeStamp) are ordered by value. Whole-day accessed ranges (DateTimeRange) are placed at the end of their respective days since the exact access time within the day is unknown. Tied positions occur where: (a) NOTES.TXT and DRAFT.DOC share the same modified time at 2s resolution, (b) README.TXT and NOTES.TXT share the same accessed date of 2025-11-03, and (c) DRAFT.DOC, BUDGET.XLS, and PHOTO.JPG share the same accessed date of 2025-11-04."@en .

###  Step 4: DFT-1182 Filter timeline around DRAFT.DOC creation
:timelineFilterAction001 rdf:type solveit-core:SolveitInvestigativeAction ;
    uco-core:name "filter-timeline" ;
    uco-core:description "Filter sorted timeline for entries within 10:20:00-10:23:00 around DRAFT.DOC creation time" ;
    solveit-core:usedTechnique solveit-data:techniqueDFT-1182 ;
    uco-action:performer :examiner-john-smith ;
    uco-action:instrument :tool-timeline-analyser ;
    uco-action:startTime "2026-02-10T09:03:30Z"^^xsd:dateTime ;
    uco-action:endTime "2026-02-10T09:04:00Z"^^xsd:dateTime ;
    uco-action:object :fatSortedTimeline001 ;
    uco-action:result :filteredSortedTimeline001 ;
    rdfs:comment "DFT-1182: Filter timeline for relevant entries - selects only entries falling within 10:20:00 to 10:23:00 on 2025-11-03 (the window around DRAFT.DOC's creation). Produces a new SortedTimeline with 4 entries: NOTES.TXT created, DRAFT.DOC created, and the tied NOTES.TXT/DRAFT.DOC modified entries."@en .

#################################################################
#    FAT files being analysed
#    Five files on a suspect USB drive with full FAT MAC timestamps
#################################################################

:fatSortFile001 rdf:type uco-observable:File ;
    rdfs:label "README.TXT"@en ;
    uco-core:name "README.TXT" ;
    uco-core:hasFacet :fatSortFile001-fileFacet ;
    rdfs:comment "A text file on the suspect FAT32 USB drive."@en .

:fatSortFile001-fileFacet rdf:type uco-observable:FileFacet ;
    uco-observable:fileName "README.TXT" ;
    uco-observable:creationTime "2025-11-03T08:12:05.320"^^xsd:dateTime ;
    uco-observable:modifiedTime "2025-11-03T08:14:10"^^xsd:dateTime ;
    uco-observable:accessedTime "2025-11-03T00:00:00"^^xsd:dateTime .

:fatSortFile002 rdf:type uco-observable:File ;
    rdfs:label "NOTES.TXT"@en ;
    uco-core:name "NOTES.TXT" ;
    uco-core:hasFacet :fatSortFile002-fileFacet ;
    rdfs:comment "A text file - created within 1 second of DRAFT.DOC (distinguishable at 10ms resolution), but modified at the same 2-second FAT resolution as DRAFT.DOC."@en .

:fatSortFile002-fileFacet rdf:type uco-observable:FileFacet ;
    uco-observable:fileName "NOTES.TXT" ;
    uco-observable:creationTime "2025-11-03T10:20:41.150"^^xsd:dateTime ;
    uco-observable:modifiedTime "2025-11-03T10:22:16"^^xsd:dateTime ;
    uco-observable:accessedTime "2025-11-03T00:00:00"^^xsd:dateTime .

:fatSortFile003 rdf:type uco-observable:File ;
    rdfs:label "DRAFT.DOC"@en ;
    uco-core:name "DRAFT.DOC" ;
    uco-core:hasFacet :fatSortFile003-fileFacet ;
    rdfs:comment "A document - created within 1 second of NOTES.TXT (distinguishable at 10ms resolution), but modified at the same 2-second FAT resolution as NOTES.TXT."@en .

:fatSortFile003-fileFacet rdf:type uco-observable:FileFacet ;
    uco-observable:fileName "DRAFT.DOC" ;
    uco-observable:creationTime "2025-11-03T10:20:41.840"^^xsd:dateTime ;
    uco-observable:modifiedTime "2025-11-03T10:22:16"^^xsd:dateTime ;
    uco-observable:accessedTime "2025-11-04T00:00:00"^^xsd:dateTime .

:fatSortFile004 rdf:type uco-observable:File ;
    rdfs:label "BUDGET.XLS"@en ;
    uco-core:name "BUDGET.XLS" ;
    uco-core:hasFacet :fatSortFile004-fileFacet ;
    rdfs:comment "A spreadsheet on the suspect FAT32 USB drive."@en .

:fatSortFile004-fileFacet rdf:type uco-observable:FileFacet ;
    uco-observable:fileName "BUDGET.XLS" ;
    uco-observable:creationTime "2025-11-03T14:05:22.010"^^xsd:dateTime ;
    uco-observable:modifiedTime "2025-11-03T14:05:30"^^xsd:dateTime ;
    uco-observable:accessedTime "2025-11-04T00:00:00"^^xsd:dateTime .

:fatSortFile005 rdf:type uco-observable:File ;
    rdfs:label "PHOTO.JPG"@en ;
    uco-core:name "PHOTO.JPG" ;
    uco-core:hasFacet :fatSortFile005-fileFacet ;
    rdfs:comment "An image file on the suspect FAT32 USB drive."@en .

:fatSortFile005-fileFacet rdf:type uco-observable:FileFacet ;
    uco-observable:fileName "PHOTO.JPG" ;
    uco-observable:creationTime "2025-11-03T19:40:55.670"^^xsd:dateTime ;
    uco-observable:modifiedTime "2025-11-03T19:41:08"^^xsd:dateTime ;
    uco-observable:accessedTime "2025-11-04T00:00:00"^^xsd:dateTime .

#################################################################
#    DateTimeStamp instances - CREATED timestamps (10ms resolution)
#    FAT created time uses 2-second base plus a hundredths-of-a-
#    second byte, giving 10ms effective resolution.
#################################################################

:file001-createdTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "README.TXT created timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T08:12:05.320"^^xsd:dateTime ;
    solveit-observable:timestampResolution "10ms" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT created time with 10ms resolution."@en .

:file002-createdTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "NOTES.TXT created timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T10:20:41.150"^^xsd:dateTime ;
    solveit-observable:timestampResolution "10ms" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT created time with 10ms resolution. Only 690ms before DRAFT.DOC - distinguishable at this resolution."@en .

:file003-createdTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "DRAFT.DOC created timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T10:20:41.840"^^xsd:dateTime ;
    solveit-observable:timestampResolution "10ms" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT created time with 10ms resolution. Only 690ms after NOTES.TXT - distinguishable at this resolution."@en .

:file004-createdTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "BUDGET.XLS created timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T14:05:22.010"^^xsd:dateTime ;
    solveit-observable:timestampResolution "10ms" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT created time with 10ms resolution."@en .

:file005-createdTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "PHOTO.JPG created timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T19:40:55.670"^^xsd:dateTime ;
    solveit-observable:timestampResolution "10ms" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT created time with 10ms resolution."@en .

#################################################################
#    DateTimeStamp instances - MODIFIED timestamps (2s resolution)
#    NOTES.TXT and DRAFT.DOC share the same 2-second value -
#    they were modified within the same 2-second window.
#################################################################

:file001-modifiedTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "README.TXT modified timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T08:14:10"^^xsd:dateTime ;
    solveit-observable:timestampResolution "2s" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT modified time with 2-second resolution."@en .

:file002-modifiedTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "NOTES.TXT modified timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T10:22:16"^^xsd:dateTime ;
    solveit-observable:timestampResolution "2s" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT modified time with 2-second resolution. Same value as DRAFT.DOC - indistinguishable at this resolution."@en .

:file003-modifiedTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "DRAFT.DOC modified timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T10:22:16"^^xsd:dateTime ;
    solveit-observable:timestampResolution "2s" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT modified time with 2-second resolution. Same value as NOTES.TXT - indistinguishable at this resolution."@en .

:file004-modifiedTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "BUDGET.XLS modified timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T14:05:30"^^xsd:dateTime ;
    solveit-observable:timestampResolution "2s" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT modified time with 2-second resolution."@en .

:file005-modifiedTs rdf:type solveit-observable:DateTimeStamp ;
    rdfs:label "PHOTO.JPG modified timestamp"@en ;
    solveit-observable:timestampValue "2025-11-03T19:41:08"^^xsd:dateTime ;
    solveit-observable:timestampResolution "2s" ;
    solveit-observable:timestampTimezone "unknown" ;
    rdfs:comment "FAT modified time with 2-second resolution."@en .

#################################################################
#    DateTimeRange instances - ACCESSED timestamps (1 day resolution)
#
#    FAT accessed time records only the date, not the time.
#    This means the access could have occurred at any point during
#    the day. We represent this as a DateTimeRange spanning the
#    entire day: [00:00:00, next day 00:00:00).
#
#    README.TXT and NOTES.TXT were accessed on 2025-11-03.
#    DRAFT.DOC, BUDGET.XLS, and PHOTO.JPG on 2025-11-04.
#################################################################

:file001-accessedRange rdf:type solveit-observable:DateTimeRange ;
    rdfs:label "README.TXT accessed date range"@en ;
    solveit-observable:startTimeInclusive "2025-11-03T00:00:00"^^xsd:dateTime ;
    solveit-observable:endTimeExclusive "2025-11-04T00:00:00"^^xsd:dateTime ;
    rdfs:comment "FAT accessed date: 2025-11-03. Spans the entire day because FAT only records the date, not the time of access."@en .

:file002-accessedRange rdf:type solveit-observable:DateTimeRange ;
    rdfs:label "NOTES.TXT accessed date range"@en ;
    solveit-observable:startTimeInclusive "2025-11-03T00:00:00"^^xsd:dateTime ;
    solveit-observable:endTimeExclusive "2025-11-04T00:00:00"^^xsd:dateTime ;
    rdfs:comment "FAT accessed date: 2025-11-03. Same day as README.TXT - these will be tied in the sorted timeline."@en .

:file003-accessedRange rdf:type solveit-observable:DateTimeRange ;
    rdfs:label "DRAFT.DOC accessed date range"@en ;
    solveit-observable:startTimeInclusive "2025-11-04T00:00:00"^^xsd:dateTime ;
    solveit-observable:endTimeExclusive "2025-11-05T00:00:00"^^xsd:dateTime ;
    rdfs:comment "FAT accessed date: 2025-11-04. Same day as BUDGET.XLS and PHOTO.JPG - these three will be tied."@en .

:file004-accessedRange rdf:type solveit-observable:DateTimeRange ;
    rdfs:label "BUDGET.XLS accessed date range"@en ;
    solveit-observable:startTimeInclusive "2025-11-04T00:00:00"^^xsd:dateTime ;
    solveit-observable:endTimeExclusive "2025-11-05T00:00:00"^^xsd:dateTime ;
    rdfs:comment "FAT accessed date: 2025-11-04. Same day as DRAFT.DOC and PHOTO.JPG - these three will be tied."@en .

:file005-accessedRange rdf:type solveit-observable:DateTimeRange ;
    rdfs:label "PHOTO.JPG accessed date range"@en ;
    solveit-observable:startTimeInclusive "2025-11-04T00:00:00"^^xsd:dateTime ;
    solveit-observable:endTimeExclusive "2025-11-05T00:00:00"^^xsd:dateTime ;
    rdfs:comment "FAT accessed date: 2025-11-04. Same day as DRAFT.DOC and BUDGET.XLS - these three will be tied."@en .

#################################################################
#    Timeline entries (15 total: 3 per file)
#    These are shared between the unsorted and sorted timelines.
#    Created/modified entries use DateTimeStamp values.
#    Accessed entries use DateTimeRange values.
#################################################################

###  README.TXT entries
:te-file001-created rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "README.TXT created"@en ;
    solveit-observable:timelineEntryValue :file001-createdTs .

:te-file001-modified rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "README.TXT modified"@en ;
    solveit-observable:timelineEntryValue :file001-modifiedTs .

:te-file001-accessed rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "README.TXT accessed"@en ;
    solveit-observable:timelineEntryValue :file001-accessedRange .

###  NOTES.TXT entries
:te-file002-created rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "NOTES.TXT created"@en ;
    solveit-observable:timelineEntryValue :file002-createdTs .

:te-file002-modified rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "NOTES.TXT modified"@en ;
    solveit-observable:timelineEntryValue :file002-modifiedTs .

:te-file002-accessed rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "NOTES.TXT accessed"@en ;
    solveit-observable:timelineEntryValue :file002-accessedRange .

###  DRAFT.DOC entries
:te-file003-created rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "DRAFT.DOC created"@en ;
    solveit-observable:timelineEntryValue :file003-createdTs .

:te-file003-modified rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "DRAFT.DOC modified"@en ;
    solveit-observable:timelineEntryValue :file003-modifiedTs .

:te-file003-accessed rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "DRAFT.DOC accessed"@en ;
    solveit-observable:timelineEntryValue :file003-accessedRange .

###  BUDGET.XLS entries
:te-file004-created rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "BUDGET.XLS created"@en ;
    solveit-observable:timelineEntryValue :file004-createdTs .

:te-file004-modified rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "BUDGET.XLS modified"@en ;
    solveit-observable:timelineEntryValue :file004-modifiedTs .

:te-file004-accessed rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "BUDGET.XLS accessed"@en ;
    solveit-observable:timelineEntryValue :file004-accessedRange .

###  PHOTO.JPG entries
:te-file005-created rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "PHOTO.JPG created"@en ;
    solveit-observable:timelineEntryValue :file005-createdTs .

:te-file005-modified rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "PHOTO.JPG modified"@en ;
    solveit-observable:timelineEntryValue :file005-modifiedTs .

:te-file005-accessed rdf:type solveit-observable:TimelineEntry ;
    rdfs:label "PHOTO.JPG accessed"@en ;
    solveit-observable:timelineEntryValue :file005-accessedRange .

#################################################################
#    The unsorted Timeline (produced by Step 2: DFT-1052)
#    Contains all 15 timeline entries with no ordering applied.
#################################################################

:fatTimeline001 rdf:type solveit-observable:Timeline ;
    rdfs:label "FAT timestamp timeline (unsorted, 15 entries)"@en ;
    solveit-observable:hasTimelineEntry :te-file001-created ,
                                        :te-file001-modified ,
                                        :te-file001-accessed ,
                                        :te-file002-created ,
                                        :te-file002-modified ,
                                        :te-file002-accessed ,
                                        :te-file003-created ,
                                        :te-file003-modified ,
                                        :te-file003-accessed ,
                                        :te-file004-created ,
                                        :te-file004-modified ,
                                        :te-file004-accessed ,
                                        :te-file005-created ,
                                        :te-file005-modified ,
                                        :te-file005-accessed ;
    rdfs:comment "Unsorted timeline containing created, modified, and accessed entries for all 5 files on the FAT32 USB drive. 15 entries total."@en .

#################################################################
#    SortedTimelineEntry wrappers (produced by Step 3: DFT-xxxx)
#
#    Full chronological sort order with positions:
#
#    Pos  Entry                       Value                    Resolution
#    ---  --------------------------  -----------------------  ----------
#     1   README.TXT created          08:12:05.320             10ms
#     2   README.TXT modified         08:14:10                 2s
#     3   NOTES.TXT created           10:20:41.150             10ms
#     4   DRAFT.DOC created           10:20:41.840             10ms
#     5   NOTES.TXT modified          10:22:16                 2s  (TIED)
#     5   DRAFT.DOC modified          10:22:16                 2s  (TIED)
#     6   BUDGET.XLS created          14:05:22.010             10ms
#     7   BUDGET.XLS modified         14:05:30                 2s
#     8   PHOTO.JPG created           19:40:55.670             10ms
#     9   PHOTO.JPG modified          19:41:08                 2s
#    10   README.TXT accessed         [2025-11-03 whole day]   1 day (TIED)
#    10   NOTES.TXT accessed          [2025-11-03 whole day]   1 day (TIED)
#    11   DRAFT.DOC accessed          [2025-11-04 whole day]   1 day (TIED)
#    11   BUDGET.XLS accessed         [2025-11-04 whole day]   1 day (TIED)
#    11   PHOTO.JPG accessed          [2025-11-04 whole day]   1 day (TIED)
#
#    Tie explanations:
#    - Position 5: NOTES.TXT and DRAFT.DOC modified times are
#      identical at 2s resolution (10:22:16). Their created times
#      differ by only 690ms but the modified times cannot be
#      distinguished.
#    - Position 10: README.TXT and NOTES.TXT accessed dates are
#      both 2025-11-03. As whole-day ranges, these are placed
#      after all point timestamps on that day. Since they span the
#      same day they are tied.
#    - Position 11: DRAFT.DOC, BUDGET.XLS, and PHOTO.JPG accessed
#      dates are all 2025-11-04. Same reasoning as position 10.
#
#    Design note on accessed date placement:
#    Accessed DateTimeRanges span an entire day (00:00:00 to next
#    day 00:00:00). They overlap with point timestamps from the
#    same day, so they cannot be precisely ordered relative to
#    those points. We place them at the END of their respective
#    days because we can only say the access happened sometime
#    that day - the safest ordering avoids implying the access
#    preceded any specific point event within the day.
#################################################################

###  Position 1: README.TXT created (08:12:05.320, 10ms)
:ste-file001-created rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "README.TXT created (position 1)"@en ;
    solveit-observable:referencesTimelineEntry :te-file001-created ;
    solveit-observable:sortPosition "1"^^xsd:nonNegativeInteger .

###  Position 2: README.TXT modified (08:14:10, 2s)
:ste-file001-modified rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "README.TXT modified (position 2)"@en ;
    solveit-observable:referencesTimelineEntry :te-file001-modified ;
    solveit-observable:sortPosition "2"^^xsd:nonNegativeInteger .

###  Position 3: NOTES.TXT created (10:20:41.150, 10ms)
:ste-file002-created rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "NOTES.TXT created (position 3)"@en ;
    solveit-observable:referencesTimelineEntry :te-file002-created ;
    solveit-observable:sortPosition "3"^^xsd:nonNegativeInteger .

###  Position 4: DRAFT.DOC created (10:20:41.840, 10ms)
:ste-file003-created rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "DRAFT.DOC created (position 4)"@en ;
    solveit-observable:referencesTimelineEntry :te-file003-created ;
    solveit-observable:sortPosition "4"^^xsd:nonNegativeInteger .

###  Position 5: NOTES.TXT modified (10:22:16, 2s) - TIED with DRAFT.DOC modified
:ste-file002-modified rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "NOTES.TXT modified (position 5, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file002-modified ;
    solveit-observable:sortPosition "5"^^xsd:nonNegativeInteger .

###  Position 5: DRAFT.DOC modified (10:22:16, 2s) - TIED with NOTES.TXT modified
:ste-file003-modified rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "DRAFT.DOC modified (position 5, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file003-modified ;
    solveit-observable:sortPosition "5"^^xsd:nonNegativeInteger .

###  Position 6: BUDGET.XLS created (14:05:22.010, 10ms)
:ste-file004-created rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "BUDGET.XLS created (position 6)"@en ;
    solveit-observable:referencesTimelineEntry :te-file004-created ;
    solveit-observable:sortPosition "6"^^xsd:nonNegativeInteger .

###  Position 7: BUDGET.XLS modified (14:05:30, 2s)
:ste-file004-modified rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "BUDGET.XLS modified (position 7)"@en ;
    solveit-observable:referencesTimelineEntry :te-file004-modified ;
    solveit-observable:sortPosition "7"^^xsd:nonNegativeInteger .

###  Position 8: PHOTO.JPG created (19:40:55.670, 10ms)
:ste-file005-created rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "PHOTO.JPG created (position 8)"@en ;
    solveit-observable:referencesTimelineEntry :te-file005-created ;
    solveit-observable:sortPosition "8"^^xsd:nonNegativeInteger .

###  Position 9: PHOTO.JPG modified (19:41:08, 2s)
:ste-file005-modified rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "PHOTO.JPG modified (position 9)"@en ;
    solveit-observable:referencesTimelineEntry :te-file005-modified ;
    solveit-observable:sortPosition "9"^^xsd:nonNegativeInteger .

###  Position 10: README.TXT accessed (2025-11-03, whole day) - TIED with NOTES.TXT accessed
:ste-file001-accessed rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "README.TXT accessed (position 10, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file001-accessed ;
    solveit-observable:sortPosition "10"^^xsd:nonNegativeInteger .

###  Position 10: NOTES.TXT accessed (2025-11-03, whole day) - TIED with README.TXT accessed
:ste-file002-accessed rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "NOTES.TXT accessed (position 10, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file002-accessed ;
    solveit-observable:sortPosition "10"^^xsd:nonNegativeInteger .

###  Position 11: DRAFT.DOC accessed (2025-11-04, whole day) - TIED with BUDGET.XLS and PHOTO.JPG
:ste-file003-accessed rdf:type solveit-observable:SortedTimelineEntry ;
    rdfs:label "DRAFT.DOC accessed (position 11, tied)"@en ;
    solveit-observable:referencesTimelineEntry :te-file003-accessed ;
