@prefix : <https://ontology.solveit-df.org/solveit/examples/> .
@prefix solveit-core: <https://ontology.solveit-df.org/solveit/core/> .
@prefix solveit-wa: <https://ontology.solveit-df.org/solveit/weakness-assessment/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@base <https://ontology.solveit-df.org/solveit/examples/> .

#################################################################
#    SOLVE-IT Weakness Assessment Examples
#    Demonstrates WeaknessEvaluation and WeaknessEvaluationSet
#    usage with Likelihood x Impact and RPN scoring
#################################################################

<https://ontology.solveit-df.org/solveit/examples/weakness-assessment> rdf:type owl:Ontology ;
    owl:versionIRI <https://ontology.solveit-df.org/solveit/examples/weakness-assessment/0.1.0> ;
    owl:imports <https://ontology.solveit-df.org/solveit/core> ,
                <https://ontology.solveit-df.org/solveit/weakness-assessment> ;
    rdfs:label "SOLVE-IT Weakness Assessment Examples"@en ;
    rdfs:comment "Example instances demonstrating weakness risk assessment using the SOLVE-IT Weakness Assessment module."@en .

#################################################################
#    Referenced Technique and Weaknesses
#################################################################

:techniqueDFT-1002 rdf:type solveit-core:Technique ;
    rdfs:label "DFT-1002: Copy sectors from storage media"@en ;
    solveit-core:techniqueID "DFT-1002" ;
    solveit-core:techniqueName "Copy sectors from storage media" ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1014 ,
                                     :weaknessDFW-1015 .

:weaknessDFW-1014 rdf:type solveit-core:Weakness ;
    rdfs:label "DFW-1014: Accessing the drive to copy data changes original data"@en ;
    solveit-core:weaknessID "DFW-1014" ;
    solveit-core:weaknessName "Accessing the drive to copy data changes original data
" .

:weaknessDFW-1015 rdf:type solveit-core:Weakness ;
    rdfs:label "DFW-1015: Powering on SSD results in sectors being wiped by TRIM operation"@en ;
    solveit-core:weaknessID "DFW-1015" ;
    solveit-core:weaknessName "Powering on SSD results in sectors being wiped by TRIM operation" .

#################################################################
#    Evaluator Identity
#################################################################

:evaluator-jane-doe rdf:type uco-identity:Identity ;
    uco-core:name "Jane Doe" ;
    rdfs:label "Jane Doe"@en .

#################################################################
#    Example WeaknessEvaluation — Likelihood x Impact only
#    Assessing DFW-1014 (Copy process changes original data)
#################################################################

:evaluation-DFW-1014-diskcopy rdf:type solveit-wa:WeaknessEvaluation ;
    rdfs:label "Evaluation of DFW-1014 for disk acquisition"@en ;
    solveit-wa:evaluatesWeakness :weaknessDFW-1014 ;
    solveit-wa:likelihoodRating 3 ;
    solveit-wa:likelihoodRationale "Without mitigation, connecting a device for acquisition is very likely to cause writes to source media through OS auto-mounting, filesystem journaling, or tool behaviour." ;
    solveit-wa:impactRating 3 ;
    solveit-wa:impactRationale "Effects of modifications to data is hard to quantify but will raise serious questions about evidential completeness, integrity and also quality and processes used." ;
    solveit-wa:liImpactScore 9 ;
    solveit-wa:evaluationContext "Traditional HDD acquisition" ;
    rdfs:comment "Likelihood x Impact assessment only (no detection difficulty). Score: 3 x 3 = 9."@en .

#################################################################
#    Example WeaknessEvaluation — Full RPN scoring
#    Assessing DFW-1015 (SSD TRIM wipes sectors on power-on)
#################################################################

:evaluation-DFW-1015-diskcopy rdf:type solveit-wa:WeaknessEvaluation ;
    rdfs:label "Evaluation of DFW-1015 for disk acquisition"@en ;
    solveit-wa:evaluatesWeakness :weaknessDFW-1015 ;
    solveit-wa:likelihoodRating 3 ;
    solveit-wa:likelihoodRationale "TRIM is enabled by default on most modern SSDs and operating systems. Powering on the device will trigger garbage collection." ;
    solveit-wa:impactRating 2 ;
    solveit-wa:impactRationale "DeleNon allocated file content in trimmed sectors will be irrecoverably lost, but allocated data and filesystem metadata are unaffected." ;
    solveit-wa:detectDifficultyRating 3 ;
    solveit-wa:detectDifficultyRationale "TRIM operations are silent and leave no log. It is difficult to determine whether data loss has occurred without a prior reference image." ;
    solveit-wa:liImpactScore 6 ;
    solveit-wa:rpnScore 18 ;
    solveit-wa:evaluationContext "SSD acquisition without prior copying" ;
    solveit-wa:evaluationNotes "Risk can be mitigated by copying via a write-blocker or by removing the SSD and connecting it through an interface that does not pass TRIM commands." ;
    rdfs:comment "Full RPN assessment. Likelihood(3) x Impact(2) x DetectionDifficulty(3) = RPN 18."@en .

#################################################################
#    Example WeaknessEvaluationSet
#    Groups the above evaluations into an assessment session
#    scoped to DFT-1002 (Copy sectors from storage media)
#################################################################

:evaluationset-diskcopy-2025 rdf:type solveit-wa:WeaknessEvaluationSet ;
    rdfs:label "Disk acquisition weakness assessment 2025"@en ;
    solveit-wa:evaluationSetName "Disk Acquisition Risk Assessment" ;
    solveit-wa:evaluationSetDescription "Assessment of weaknesses associated with disk acquisition (DFT-1002) in a traditional HDD acquisition context." ;
    solveit-wa:evaluationDate "2025-03-01"^^xsd:date ;
    solveit-wa:evaluatedBy :evaluator-jane-doe ;
    solveit-wa:scopedToTechnique :techniqueDFT-1002 ;
    solveit-wa:hasEvaluation :evaluation-DFW-1014-diskcopy ,
                             :evaluation-DFW-1015-diskcopy ;
    rdfs:comment "An evaluation set grouping two weakness assessments for disk acquisition. Demonstrates both LI-only and full RPN scoring within a single set."@en .
