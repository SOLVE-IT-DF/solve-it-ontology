@prefix : <https://ontology.solveit-df.org/solveit/examples/> .
@prefix solveit-core: <https://ontology.solveit-df.org/solveit/core/> .
@prefix solveit-data: <https://ontology.solveit-df.org/solveit/data/> .
@prefix solveit-observable: <https://ontology.solveit-df.org/solveit/observable/> .
@prefix solveit-tool-profile: <https://ontology.solveit-df.org/solveit/tool-profile/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-tool: <https://ontology.unifiedcyberontology.org/uco/tool/> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix uco-action: <https://ontology.unifiedcyberontology.org/uco/action/> .
@prefix uco-identity: <https://ontology.unifiedcyberontology.org/uco/identity/> .
@base <https://ontology.solveit-df.org/solveit/examples/> .

#################################################################
#    SOLVE-IT Tool Profile Examples
#    Demonstrates ToolCapabilityProfile, MitigationCapability
#    and SolveitAwareInstrument, including two publishers making
#    the same claim at different scopes, each as an Identity,
#    and one of them naming the weaknesses the claim was
#    established for and the report that established them
#################################################################

<https://ontology.solveit-df.org/solveit/examples/tool-profile> rdf:type owl:Ontology ;
    owl:versionIRI <https://ontology.solveit-df.org/solveit/examples/tool-profile/0.1.0> ;
    owl:imports <https://ontology.solveit-df.org/solveit/core> ,
                <https://ontology.solveit-df.org/solveit/observable> ,
                <https://ontology.solveit-df.org/solveit/tool-profile> ;
    rdfs:label "SOLVE-IT Tool Profile Examples"@en ;
    rdfs:comment "Example instances demonstrating tool capability profiles. The two profiles below were generated by the SOLVE-IT Workflow Builder's Turtle export and re-homed in the examples namespace, so they show what the tooling actually emits rather than a hand-written approximation."@en .

#################################################################
#    Referenced Technique and Mitigation
#
#    DFT-1072 declares solveit-observable:ChatAppFiles as its
#    CASE input class, which is what the condition below targets.
#
#    DFW-1085 lists four mitigations. Three of them - dual tool
#    verification, and correlation against the service provider
#    or another participant - are things an examiner does, not
#    things a tool can be tested for. Only DFM-1054 is a property
#    of the tool, which is why it is the only one a capability
#    profile here claims.
#
#    Three of the weaknesses DFM-1054 addresses are declared
#    below, out of the eighteen it addresses in the knowledge
#    base. They are here so the scope of a claim can be seen:
#    profile 1 establishes DFM-1054 for two of them and says
#    nothing about the third.
#################################################################

solveit-data:techniqueDFT-1072 a owl:Class , solveit-core:Technique ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    rdfs:label "DFT-1072: Extract artifacts from chat app(s)"@en ;
    solveit-core:techniqueID "DFT-1072" ;
    solveit-core:techniqueName "Extract artifacts from chat app(s)" ;
    solveit-core:hasPotentialWeakness solveit-data:weaknessDFW-1085 ,
                                      solveit-data:weaknessDFW-1086 ,
                                      solveit-data:weaknessDFW-1087 .

solveit-data:weaknessDFW-1085 rdf:type solveit-core:Weakness ;
    rdfs:label "DFW-1085: Missing messages from the live set of messages"@en ;
    solveit-core:weaknessID "DFW-1085" ;
    solveit-core:weaknessName "Missing messages from the live set of messages" ;
    solveit-core:hasPotentialMitigation solveit-data:mitigationDFM-1054 .

solveit-data:weaknessDFW-1086 rdf:type solveit-core:Weakness ;
    rdfs:label "DFW-1086: Failing to recover deleted but recoverable messages"@en ;
    solveit-core:weaknessID "DFW-1086" ;
    solveit-core:weaknessName "Failing to recover deleted but recoverable messages" ;
    solveit-core:hasPotentialMitigation solveit-data:mitigationDFM-1054 .

solveit-data:weaknessDFW-1087 rdf:type solveit-core:Weakness ;
    rdfs:label "DFW-1087: Presenting a live message that did not exist"@en ;
    solveit-core:weaknessID "DFW-1087" ;
    solveit-core:weaknessName "Presenting a live message that did not exist" ;
    solveit-core:hasPotentialMitigation solveit-data:mitigationDFM-1054 .

solveit-data:mitigationDFM-1054 rdf:type solveit-core:Mitigation ;
    rdfs:label "DFM-1054: Testing of message extraction and parsing features"@en ;
    solveit-core:mitigationID "DFM-1054" ;
    solveit-core:mitigationName "Testing of message extraction and parsing features" .

#################################################################
#    Profile 1 - an independent testing programme
#
#    Claims DFM-1054, scoped twice over because that is what was
#    tested. appliesWhen scopes it to WhatsApp 13.8-14.0; the
#    shape carries sh:severity sh:Info and a message describing
#    the declared scope, so a placement outside it is not a
#    failure, it is a case this profile says nothing about.
#    establishedForWeakness scopes it to DFW-1085 and DFW-1086,
#    the two weaknesses the test campaign covered. Without that,
#    the claim would be read as reaching every weakness DFM-1054
#    addresses, DFW-1087 included, which was never tested.
#
#    supportingCitation names the test report. The Citation is
#    minted by this profile and carries plain text but no
#    citationID, so nothing here depends on the report being
#    registered in the DFCite series.
#################################################################

:acme-chat-parser-v1-0-national-testing-programme rdf:type solveit-tool-profile:ToolCapabilityProfile ;
    rdfs:label "ACME Chat Parser v1.0 (National Testing Programme)"@en ;
    uco-core:description "Independently validated capability profile for ACME Chat Parser 1.0." ;
    solveit-tool-profile:profileFor :acme-chat-parser-v1-0-national-testing-programme-tool ;
    solveit-tool-profile:publishedBy :acme-chat-parser-v1-0-national-testing-programme-publisher ;
    solveit-tool-profile:publishedDate "2026-01-15T00:00:00Z"^^xsd:dateTime ;
    solveit-tool-profile:supportsTechnique solveit-data:techniqueDFT-1072 ;
    solveit-tool-profile:hasMitigationCapability :acme-chat-parser-v1-0-national-testing-programme-cap-1-dfm-1054 .

:acme-chat-parser-v1-0-national-testing-programme-tool rdf:type uco-tool:Tool ;
    rdfs:label "ACME Chat Parser"@en ;
    uco-core:name "ACME Chat Parser" ;
    uco-tool:version "1.0" .

:acme-chat-parser-v1-0-national-testing-programme-publisher rdf:type uco-identity:Identity ;
    uco-core:name "National Testing Programme" .

:acme-chat-parser-v1-0-national-testing-programme-cap-1-dfm-1054 rdf:type solveit-tool-profile:MitigationCapability ;
    rdfs:label "Message extraction and parsing tested for WhatsApp 13.8-14.0"@en ;
    uco-core:description "Independently tested against WhatsApp 13.8, 13.9 and 14.0 only." ;
    solveit-tool-profile:implementsMitigation solveit-data:mitigationDFM-1054 ;
    solveit-tool-profile:establishedForWeakness solveit-data:weaknessDFW-1085 ,
                                                solveit-data:weaknessDFW-1086 ;
    solveit-tool-profile:supportingCitation :acme-chat-parser-v1-0-national-testing-programme-citation-1 ;
    solveit-tool-profile:conditionTarget solveit-tool-profile:ObjectTarget ;
    solveit-tool-profile:appliesWhen :acme-chat-parser-v1-0-national-testing-programme-shape-1-dfm-1054 .

:acme-chat-parser-v1-0-national-testing-programme-citation-1 rdf:type solveit-core:Citation ;
    rdfs:label "NTP-TR-2026-014: ACME Chat Parser 1.0 message extraction test report"@en ;
    solveit-core:citationPlaintext "National Testing Programme (2026) ACME Chat Parser 1.0: message extraction and parsing test report. NTP-TR-2026-014." .

:acme-chat-parser-v1-0-national-testing-programme-shape-1-dfm-1054 rdf:type sh:NodeShape ;
    sh:targetClass solveit-observable:ChatAppFiles ;
    sh:severity sh:Info ;
    sh:message "Mitigation DFM-1054 has not been established for this step by this profile. Declared scope — application: com.whatsapp; tested versions: 13.8, 13.9, 14.0." ;
    sh:property [
        sh:path ( solveit-observable:sourceApplication uco-core:hasFacet uco-observable:applicationIdentifier ) ;
        sh:hasValue "com.whatsapp"
    ] ;
    sh:property [
        sh:path ( solveit-observable:sourceApplication uco-core:hasFacet uco-observable:version ) ;
        sh:in ( "13.8" "13.9" "14.0" )
    ] .

#################################################################
#    Profile 2 - the vendor, claiming the same mitigation
#
#    Same tool, same mitigation, no scope declared - neither an
#    appliesWhen condition nor an establishedForWeakness. This is
#    the case the two-publisher model exists for: the claims are
#    not merged, and a reader can see who asserted what and how
#    narrowly. A consumer that trusts one publisher over the
#    other has the attribution needed to act on that.
#
#    It is also the form every profile published before 0.2.6
#    takes, which is why MitigationCapabilityShape reports it at
#    sh:Info and no higher. Validating this file with
#    --allow-info produces exactly that one result.
#################################################################

:acme-chat-parser-v1-0-acme-forensics rdf:type solveit-tool-profile:ToolCapabilityProfile ;
    rdfs:label "ACME Chat Parser v1.0 (ACME Forensics)"@en ;
    uco-core:description "Vendor capability profile for ACME Chat Parser 1.0." ;
    solveit-tool-profile:profileFor :acme-chat-parser-v1-0-acme-forensics-tool ;
    solveit-tool-profile:publishedBy :acme-chat-parser-v1-0-acme-forensics-publisher ;
    solveit-tool-profile:publishedDate "2025-11-02T00:00:00Z"^^xsd:dateTime ;
    solveit-tool-profile:supportsTechnique solveit-data:techniqueDFT-1072 ;
    solveit-tool-profile:hasMitigationCapability :acme-chat-parser-v1-0-acme-forensics-cap-1-dfm-1054 .

:acme-chat-parser-v1-0-acme-forensics-tool rdf:type uco-tool:Tool ;
    rdfs:label "ACME Chat Parser"@en ;
    uco-core:name "ACME Chat Parser" ;
    uco-tool:version "1.0" .

:acme-chat-parser-v1-0-acme-forensics-publisher rdf:type uco-identity:Identity ;
    uco-core:name "ACME Forensics" .

:acme-chat-parser-v1-0-acme-forensics-cap-1-dfm-1054 rdf:type solveit-tool-profile:MitigationCapability ;
    rdfs:label "Message extraction and parsing tested in-house"@en ;
    uco-core:description "Declared for all supported chat applications; no scope stated." ;
    solveit-tool-profile:implementsMitigation solveit-data:mitigationDFM-1054 .

#################################################################
#    Consulting a profile from a workflow
#
#    A SolveitAwareInstrument is a tool assessed against SOLVE-IT
#    capability profiles; consultedProfile is what makes it one
#    rather than a bare uco-tool:Tool reference. It records which
#    profiles a lab consulted, without restating their claims -
#    those live in the profile documents above, under their own
#    publisher's attribution.
#################################################################

:acme-chat-parser-as-consulted rdf:type solveit-tool-profile:SolveitAwareInstrument ;
    rdfs:label "ACME Chat Parser 1.0, as consulted for this examination"@en ;
    uco-core:name "ACME Chat Parser" ;
    uco-tool:version "1.0" ;
    solveit-tool-profile:consultedProfile :acme-chat-parser-v1-0-national-testing-programme ,
                                         :acme-chat-parser-v1-0-acme-forensics .
