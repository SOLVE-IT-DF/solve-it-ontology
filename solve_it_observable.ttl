@prefix : <https://ontology.solveit-df.org/observable/> .
@prefix solve-it: <https://ontology.solveit-df.org/> .
@prefix solve-it-observable: <https://ontology.solveit-df.org/observable/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@base <https://ontology.solveit-df.org/observable/> .

#################################################################
#    SOLVE-IT Observable Module
#    Observable objects and facets for digital forensics
#################################################################

<https://ontology.solveit-df.org/observable> rdf:type owl:Ontology ;
    owl:versionIRI <https://ontology.solveit-df.org/observable/1.0.0> ;
    owl:imports <https://ontology.unifiedcyberontology.org/uco/core/1.3.0> ,
                <https://ontology.unifiedcyberontology.org/uco/observable/1.3.0> ;
    dcterms:title "SOLVE-IT Observable Module"@en ;
    dcterms:description "Observable objects for SOLVE-IT digital forensics, including video frames and other forensic artifacts."@en ;
    dcterms:creator "SOLVE-IT Project" ;
    owl:versionInfo "0.0.1" ;
    rdfs:label "SOLVE-IT Observable Module"@en .

#################################################################
#    Classes
#################################################################

###  VideoFrame Observable Object
solve-it-observable:VideoFrame rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Video Frame"@en ;
    rdfs:comment "A single frame extracted from a video file during forensic analysis."@en .

###  NetworkPacketCapture Observable Object
solve-it-observable:NetworkPacketCapture rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Network Packet Capture"@en ;
    rdfs:comment "A network packet capture file."@en .

###  DecryptionKey Observable Object
solve-it-observable:DecryptionKey rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Decryption Key"@en ;
    rdfs:comment "A cryptographic key intended for decryption."@en .

###  UnlockPattern Observable Object
solve-it-observable:UnlockPattern rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Unlock Pattern"@en ;
    rdfs:comment "A pattern used to unlock a device, i.e. screen lock pattern."@en .

###  RedactedFileSet Observable Object
solve-it-observable:RedactedFileSet rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Redacted File Set"@en ;
    rdfs:comment "A collection of files post-redaction."@en .

###  RedactedArtifactSet Observable Object
solve-it-observable:RedactedArtifactSet rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Redacted Artifact Set"@en ;
    rdfs:comment "A collection of artifacts post-redaction."@en .

###  KeywordSearchResult Observable Object
solve-it-observable:KeywordSearchResult rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Keyword Search Result"@en ;
    rdfs:comment "A result from a keyword search operation during forensic analysis."@en .

###  Timeline Observable Object
solve-it-observable:Timeline rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Timeline"@en ;
    rdfs:comment "A set of timeline entries extracted during forensic analysis."@en .

###  TimelineEntry Observable Object
solve-it-observable:TimelineEntry rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Timeline Entry"@en ;
    rdfs:comment "A single entry in a forensic timeline."@en .

#################################################################
#    Object Properties
#################################################################

solve-it-observable:extractedFromVideo rdf:type owl:ObjectProperty ;
    rdfs:domain solve-it-observable:VideoFrame ;
    rdfs:range uco-observable:File ;
    rdfs:label "extracted from video"@en ;
    rdfs:comment "Links a VideoFrame to the source video file."@en .

solve-it-observable:hasTimelineEntry rdf:type owl:ObjectProperty ;
    rdfs:domain solve-it-observable:Timeline ;
    rdfs:range solve-it-observable:TimelineEntry ;
    rdfs:label "has timeline entry"@en ;
    rdfs:comment "Links a Timeline to its TimelineEntry instances."@en .

#################################################################
#    Data Properties
#################################################################

solve-it-observable:videoFrameNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain solve-it-observable:VideoFrame ;
    rdfs:range xsd:integer ;
    rdfs:label "frame number"@en ;
    rdfs:comment "The sequential number of this frame in the video."@en .

solve-it-observable:videoFramePixelWidth rdf:type owl:DatatypeProperty ;
    rdfs:domain solve-it-observable:VideoFrame ;
    rdfs:range xsd:integer ;
    rdfs:label "width"@en ;
    rdfs:comment "Video frame width in pixels."@en .

solve-it-observable:videoFramePixelHeight rdf:type owl:DatatypeProperty ;
    rdfs:domain solve-it-observable:VideoFrame ;
    rdfs:range xsd:integer ;
    rdfs:label "height"@en ;
    rdfs:comment "Video frame height in pixels."@en .
