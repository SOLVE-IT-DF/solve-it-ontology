@prefix : <https://ontology.solveit-df.org/solveit/observable/> .
@prefix solveit-observable: <https://ontology.solveit-df.org/solveit/observable/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@base <https://ontology.solveit-df.org/solveit/observable/> .

#################################################################
#    SOLVE-IT Observable Module
#    Observable objects and facets for digital forensics
#################################################################

<https://ontology.solveit-df.org/solveit/observable> rdf:type owl:Ontology ;
    owl:versionIRI <https://ontology.solveit-df.org/solveit/observable/1.0.0> ;
    owl:imports <https://ontology.unifiedcyberontology.org/uco/core/1.3.0> ,
                <https://ontology.unifiedcyberontology.org/uco/observable/1.3.0> ;
    dcterms:title "SOLVE-IT Observable Module"@en ;
    dcterms:description "Observable objects for SOLVE-IT digital forensics, including video frames and other forensic artifacts."@en ;
    dcterms:creator "SOLVE-IT Project" ;
    owl:versionInfo "0.0.1" ;
    rdfs:label "SOLVE-IT Observable Module"@en .

#################################################################
#    Classes
#################################################################

###  VideoFrame Observable Object
solveit-observable:VideoFrame rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Video Frame"@en ;
    rdfs:comment "A single frame extracted from a video file during forensic analysis."@en .

###  NetworkPacketCapture Observable Object
solveit-observable:NetworkPacketCapture rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Network Packet Capture"@en ;
    rdfs:comment "A network packet capture file."@en .

###  DecryptionKey Observable Object
solveit-observable:DecryptionKey rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Decryption Key"@en ;
    rdfs:comment "A cryptographic key intended for decryption."@en .

###  UnlockPattern Observable Object
solveit-observable:UnlockPattern rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Unlock Pattern"@en ;
    rdfs:comment "A pattern used to unlock a device, i.e. screen lock pattern."@en .

###  RedactedFileSet Observable Object
solveit-observable:RedactedFileSet rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Redacted File Set"@en ;
    rdfs:comment "A collection of files post-redaction."@en .

###  RedactedArtifactSet Observable Object
solveit-observable:RedactedArtifactSet rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Redacted Artifact Set"@en ;
    rdfs:comment "A collection of artifacts post-redaction."@en .

###  KeywordSearchResult Observable Object
solveit-observable:KeywordSearchResult rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Keyword Search Result"@en ;
    rdfs:comment "A result from a keyword search operation during forensic analysis."@en .

###  Timeline Observable Object
solveit-observable:Timeline rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Timeline"@en ;
    rdfs:comment "A set of timeline entries extracted during forensic analysis."@en .

###  TimelineEntry Observable Object
solveit-observable:TimelineEntry rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Timeline Entry"@en ;
    rdfs:comment "A single entry in a forensic timeline."@en .

###  ClockOffset Observable Object
solveit-observable:ClockOffset rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Clock Offset"@en ;
    rdfs:comment "The time offset between a device clock and a reference time."@en .

###  KeywordIndex Observable Object
solveit-observable:KeywordIndex rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Keyword Index"@en ;
    rdfs:comment "An index of keywords created during forensic analysis."@en .

###  KeywordIndexingConfiguration Observable Object
solveit-observable:KeywordIndexingConfiguration rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Keyword Indexing Configuration"@en ;
    rdfs:comment "Configuration settings used for keyword indexing during forensic analysis."@en .

###  httpResponseHeader Observable Object
solveit-observable:httpResponseHeader rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "HTTP Response Header"@en ;
    rdfs:comment "An HTTP response header containing multiple header fields from an HTTP server response."@en .

###  DateTimeStamp Observable Object
solveit-observable:DateTimeStamp rdf:type owl:Class ;
    rdfs:subClassOf uco-observable:ObservableObject ;
    rdfs:label "Date Time Stamp"@en ;
    rdfs:comment "A timestamp observed in forensic analysis."@en .

#################################################################
#    Object Properties
#################################################################

solveit-observable:extractedFromVideo rdf:type owl:ObjectProperty ;
    rdfs:domain solveit-observable:VideoFrame ;
    rdfs:range uco-observable:File ;
    rdfs:label "extracted from video"@en ;
    rdfs:comment "Links a VideoFrame to the source video file."@en .

solveit-observable:hasTimelineEntry rdf:type owl:ObjectProperty ;
    rdfs:domain solveit-observable:Timeline ;
    rdfs:range solveit-observable:TimelineEntry ;
    rdfs:label "has timeline entry"@en ;
    rdfs:comment "Links a Timeline to its TimelineEntry instances."@en .

solveit-observable:hasConfiguration rdf:type owl:ObjectProperty ;
    rdfs:domain solveit-observable:KeywordIndex ;
    rdfs:range solveit-observable:KeywordIndexingConfiguration ;
    rdfs:label "has configuration"@en ;
    rdfs:comment "Links a KeywordIndex to its KeywordIndexingConfiguration."@en .

#################################################################
#    Data Properties
#################################################################

solveit-observable:videoFrameNumber rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:VideoFrame ;
    rdfs:range xsd:integer ;
    rdfs:label "frame number"@en ;
    rdfs:comment "The sequential number of this frame in the video."@en .

solveit-observable:videoFramePixelWidth rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:VideoFrame ;
    rdfs:range xsd:integer ;
    rdfs:label "width"@en ;
    rdfs:comment "Video frame width in pixels."@en .

solveit-observable:videoFramePixelHeight rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:VideoFrame ;
    rdfs:range xsd:integer ;
    rdfs:label "height"@en ;
    rdfs:comment "Video frame height in pixels."@en .

solveit-observable:offsetValue rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:ClockOffset ;
    rdfs:range xsd:decimal ;
    rdfs:label "offset value"@en ;
    rdfs:comment "The clock offset value in seconds. Positive values indicate the clock is ahead, negative values indicate it is behind."@en .

solveit-observable:clockOffsetKnownAt rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:ClockOffset ;
    rdfs:range xsd:dateTime ;
    rdfs:label "clock offset known at"@en ;
    rdfs:comment "The specific point in time when this clock offset was determined."@en .

solveit-observable:timestampValue rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:DateTimeStamp ;
    rdfs:range xsd:dateTime ;
    rdfs:label "timestamp value"@en ;
    rdfs:comment "The date and time value of the timestamp."@en .

solveit-observable:timestampResolution rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:DateTimeStamp ;
    rdfs:range xsd:string ;
    rdfs:label "timestamp resolution"@en ;
    rdfs:comment "The precision or resolution of the timestamp (e.g., seconds, milliseconds, microseconds)."@en .

solveit-observable:timestampTimezone rdf:type owl:DatatypeProperty ;
    rdfs:domain solveit-observable:DateTimeStamp ;
    rdfs:range xsd:string ;
    rdfs:label "timestamp timezone"@en ;
    rdfs:comment "The timezone of the timestamp."@en .
