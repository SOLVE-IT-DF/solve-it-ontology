  {
    "@id": "https://ontology.solveit-df.org/solveit/data/techniqueT1034",
    "@type": [
      "https://ontology.solveit-df.org/solveit/core/Technique"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1034: Brute force attack"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/password"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1140"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1141"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1142"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "Kanta, A., Coray, S., Coisel, I. and Scanlon, M., 2021. How viable is password cracking in digital forensic investigation? Analyzing the guessability of over 3.9 billion real-world accounts. Forensic Science International: Digital Investigation, 37, p.301186."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasSynonym": [
      {
        "@value": "exhaustive password search"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "A brute force attack, or exhaustive search is a password cracking approach where every combination of characters is tested until the correct one is found. This method is \"guaranteed to work\" given infinite time and resources which in a real-life scenario is not feasible."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "Brute force attack involves trying every possible combination in a defined search space to find the correct value. The search space could be limited to just numbers, for example in the case of a 4-digit PIN number, or alphanumerical values or even the full ASCII character set. The larger the search space, the longer it takes to complete a brute force attack."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1034"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Brute force attack"
      }
    ]
  },
  {
    "@id": "https://ontology.solveit-df.org/solveit/data/mitigationM1052",
    "@type": [
      "https://ontology.solveit-df.org/solveit/core/Mitigation"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
