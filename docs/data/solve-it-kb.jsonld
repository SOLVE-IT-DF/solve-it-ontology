      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "Lyle, J.R., 2006. A strategy for testing hardware write block devices. digital investigation, 3, pp.3-9."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "A hardware write blocking device [should] prevent any change to data in the user area of a hard drive while allowing access to all data on a hard drive. (Lyle 2006)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "Note that \"Sometimes it may be desirable to change a drive configuration to obtain access to otherwise hidden sectors, for example, such as within an HPA (host protected area).\" (Lyle 2006) "
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1012"
      }
    ],
