    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1031: Key recovery from memory"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.solveit-df.org/solveit/observable/DecryptionKey"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasExample": [
      {
        "@value": "Bulk Extractor - of the many scanners within bulk extractor, one of which attempts to locate AES keys."
      },
      {
        "@value": "Volatility - the plug in ‘trucryptmaster’ attempts to recover Truecrypt 7.1a master keys."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1044"
