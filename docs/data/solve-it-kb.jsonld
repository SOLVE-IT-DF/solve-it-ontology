      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1128"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "Kessler, G.C., 2016. The impact of MD5 file hash collisions on digital forensic imaging. Journal of digital forensics, security and law, 11(4), p.9."
      },
      {
        "@value": "Kessler GC. The impact of SHA-1 file hash collisions on digital forensic imaging: A follow-up experiment. Journal of Digital Forensics, Security and Law. 2016;11(4):10."
      },
      {
        "@value": "Lyle, J., 2002. Testing disk imaging tools. DFRWS USA 2002, https://dfrws.org/wp-content/uploads/2019/06/2002_USA_paper-testing_disk_imaging_tools.pdf"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "Computing the hash function of the entire contents of a disk, recording it, and then subsequently computing the hash over any disk image created to detect if any content is different (adapted from Lyle 2002)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1042"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Disk image hash verification"
      }
    ]
  },
