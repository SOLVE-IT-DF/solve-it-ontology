      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1065"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1066"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1067"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "Nikkel, B., 2009. Forensic analysis of GPT disks and GUID partition tables. Digital Investigation, 6(1-2), pp.39-47."
      },
      {
        "@value": "Carrier, B., 2005. File system forensic analysis. Addison-Wesley Professional."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasSynonym": [
      {
        "@value": "media management analysis"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "Partitions are defined as ‘allocated contiguous sets of sectors from storage media’. This involves recovering the list of partitions that exist on a storage media."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "Partitions schemes include: MBR, GPT, APM. Some schemes such as GPT have records of the partitions in a single area (plus a backup partition table), others such as MBR make use of Extended Partition Tables (EPTs) that are scattered throughout the disk.\n\nPartitions can also be deleted but may be recoverable if the start sectors of the volumes contained within them can be identified. "
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1059"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Identify partitions"
      }
    ]
  },
