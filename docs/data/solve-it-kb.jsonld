      "https://ontology.solveit-df.org/solveit/core/Technique"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1062: Decryption of encrypted file systems/volumes"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/Volume"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/Image"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "todo"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "The process of decrypting an encrypted file system/volume to make its contents accessible for analysis."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "The output of this process will vary depending on the encryption implementation in place. If encryption is at the sector level then it would result in a decrypted forensic image, but if it uses file-based encryption then the process would result in an equivalent volume but with the file content/metadata decrypted."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1062"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Decryption of encrypted file systems/volumes"
      }
    ]
  },
