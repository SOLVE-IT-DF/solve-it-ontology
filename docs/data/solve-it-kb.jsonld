  {
    "@id": "https://ontology.solveit-df.org/solveit/data/techniqueT1043",
    "@type": [
      "https://ontology.solveit-df.org/solveit/core/Technique"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1043: Decode forensic image format"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/Image"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/File"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasExample": [
      {
        "@value": "Expert Witness Format (EWF)"
      },
      {
        "@value": "Advanced Forensic Format (AFF)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1121"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1122"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1123"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1259"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "Cohen, M., Garfinkel, S. and Schatz, B., 2009. Extending the advanced forensic format to accommodate multiple data sources, logical evidence, arbitrary information and forensic workflow. digital investigation, 6, pp.S57-S68."
      },
      {
        "@value": "Im, S., Park, H., Joun, J., Lee, S. and Park, J., 2024. Revisiting logical image formats for future digital forensics: A comprehensive analysis on L01 and AFF4-L. Forensic Science International: Digital Investigation, 50"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasSynonym": [
      {
        "@value": "Read forensic format"
      },
      {
        "@value": "Read forensic image"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "The decoding of a forensic format such as EWF such that the raw sectors can be accessed by a forensic tool (typically performed on-the-fly internally in a tool.)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "For example a EWF (Expert Witness Format) needs to be processed to expose the equivalent RAW image sectors. Therefore both the input and output types here are [https://ontology.unifiedcyberontology.org/uco/observable/Image]. This technique would not need to be used when working with a RAW image format directly. This also includes decoding logical formats such as L01, AD1, CTR, or AFF4-L. The output here is not an image file but rather a set of files and their metadata"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1043"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Decode forensic image format"
      }
    ]
  },
