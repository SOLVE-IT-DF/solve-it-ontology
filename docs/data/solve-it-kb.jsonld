  {
    "@id": "https://ontology.solveit-df.org/solveit/data/techniqueT1025",
    "@type": [
      "https://ontology.solveit-df.org/solveit/core/Technique"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1025: Writing data to a forensic image format"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/Image"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasExample": [
      {
        "@value": "2009 M57-Jean - Data is supplied as a ‘multi-volume Expert Witness file’ - i.e. split EnCase E01 & E02 image files (https://digitalcorpora.org/corpora/scenarios/m57-jean/)"
      },
      {
        "@value": "FTK Imager: This tool can be used to acquire data from block devices in various image formats including RAW, EWF, and AFF"
      },
      {
        "@value": "Magnet Acquire: This tool can be used to acquire data from block devices in various image formats including RAW and EWF."
      },
      {
        "@value": "libewf: This open source library allows access to the EWF format. The accompanying ewftools proves tools to verify, inspect and create EWF images. "
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1043"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "todo"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasSynonym": [
      {
        "@value": "Disk image container"
      },
      {
        "@value": "image file"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "Storage of data recovered from a digital device. Popular formats are RAW, EWF, AFF4 and some proprietary logical formats from other tool vendors. "
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "Formats:\n\nRaw: \n\nEWF:\n\nAFF: \n\n\nThe imaged data may be split into several linked container formats. e.g. e01, e02 e03 etc."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1025"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Writing data to a forensic image format"
      }
    ]
  },
