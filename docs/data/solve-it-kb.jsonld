      },
      {
        "@value": "Zeitgeist"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "Metz (2011), Windows Search forensics, https://www.forensicfocus.com/articles/windows-search-forensics/"
      },
      {
        "@value": "The Zeitgeist Project (2021) https://zeitgeist.freedesktop.org"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "Examine information from operating system artifacts relating to content indexing and search capabilities e.g. Windows Desktop Search"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "For example the Windows Search database '...contains vast amount of values about various of artifacts found on a Windows system, e.g. files and directories, emails, appointments, attachments, images, audio and video' (Metz 2011)"
      }
    ],
