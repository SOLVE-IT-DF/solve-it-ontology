      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/hash"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1042"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1124"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1125"
      },
      {
