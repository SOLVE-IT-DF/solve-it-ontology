    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "Running commands on a live system to collect specific pieces of information e.g. running processes or open ports"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "Prior to collecting data from the system, pre-stages are described in (Waits et al 2008) as:\n- Establish trusted command shell\n- Establish method for transmitting and storing the information\n"
      }
    ],
