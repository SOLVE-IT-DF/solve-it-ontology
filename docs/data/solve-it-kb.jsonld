    ]
  },
  {
    "@id": "https://ontology.solveit-df.org/solveit/data/techniqueT1134",
    "@type": [
      "https://ontology.solveit-df.org/solveit/core/Technique"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1134: Use time anchors to estimate clock offset"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.solveit-df.org/solveit/observable/ClockOffset"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasExample": [
      {
        "@value": "Browser caches often contain local timestamps and those derived from external servers"
      },
      {
        "@value": "Records in web browser history databases contain local timestamps and, in some cases, timestamps from external servers, embedded in URLs"
      },
      {
        "@value": "Email headers often record timestamps derived from external mail servers as well as timestamps generated by the local system time"
      },
      {
        "@value": "Missed call or voicemail notification messages often include a timestamp derived from an external time source, e.g., missed call from XX on 2018-06-06 at 01:32:49 pm, which can be compared to the local file system time the message was received"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1260"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1261"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1262"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1263"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "C. Vanini, C. Hargreaves, H. van Beek, F. Breitinger, 2024, Was the clock correct? Exploring timestamp interpretation through time anchors for digital forensic event reconstruction, Forensic Science International: Digital Investigation, 10.1016/j.fsidi.2024.301759"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasSynonym": [
      {
        "@value": "Timestamp correlation"
      },
      {
        "@value": "Time anchoring (Vanini et al 2024)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "Correlate timestamps from the system clock and an external trusted time source (Time Anchoring)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "Correlate timestamps from the system clock and an external trusted source of time contained in the same artifact, allowing an offset to be estimated *for the point in time the timestamp was recorded*"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1134"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Use time anchors to estimate clock offset"
      }
    ]
  },
