  {
    "@id": "https://ontology.solveit-df.org/solveit/data/techniqueT1059",
    "@type": [
      "https://ontology.solveit-df.org/solveit/core/Technique"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1059: Identify partitions"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/DiskPartition"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/partitionOffset"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.unifiedcyberontology.org/uco/observable/partitionLength"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasExample": [
      {
        "@value": "Hargreaves, Nelson and Casey (2024) provides a dataset with a deleted but recoverable partition that can be used for tool evaluation."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1063"
      },
      {
