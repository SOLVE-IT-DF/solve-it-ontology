  {
    "@id": "https://ontology.solveit-df.org/solveit/data/techniqueT1086",
    "@type": [
      "https://ontology.solveit-df.org/solveit/core/Technique"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "T1086: Timeline analysis"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasCASEOutputClass": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.solveit-df.org/solveit/observable/Timeline"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#anyURI",
        "@value": "https://ontology.solveit-df.org/solveit/observable/TimelineEntry"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasExample": [
      {
        "@value": "TimeSketch (Berggren et al. 2014)"
      },
      {
        "@value": "PyDFT (Hargreaves & Patterson 2012)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasPotentialWeakness": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1148"
      },
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/weaknessW1266"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasReference": [
      {
        "@value": "Berggren at al. (2014) TimeSketch, https://timesketch.org"
      },
      {
        "@value": "Breitinger, F., Studiawan, H. and Hargreaves, C., 2025. SoK: Timeline based event reconstruction for digital forensics: Terminology, methodology, and current challenges."
      },
      {
        "@value": "Casey, E., 2011. Digital evidence and computer crime: Forensic science, computers, and the internet. Academic press, Section 8.1.2"
      },
      {
        "@value": "Hargreaves, C. and Patterson, J., 2012. An automated timeline reconstruction approach for digital forensic investigations. Digital Investigation, 9, pp.S69-S79."
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasSubtechnique": [
      {
        "@id": "https://ontology.solveit-df.org/solveit/data/techniqueT1134"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/hasSynonym": [
      {
        "@value": "Temporal Analysis"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDescription": [
      {
        "@value": "The process of searching, filtering, sorting, highlighting, or aggregating timeline entries to determine which are relevant for event reconstruction, or to identify times of interest (adapted from Breitinger et al. 2025)"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueDetails": [
      {
        "@value": "This can involve refinement approaches such as: filtering irrelevant entries, highlighting key entries, or aggregating entries into more meaningful events. This may result in a filtered timeline, or a set of highlighted timeline entries"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueID": [
      {
        "@value": "T1086"
      }
    ],
    "https://ontology.solveit-df.org/solveit/core/techniqueName": [
      {
        "@value": "Timeline analysis"
      }
    ]
  },
