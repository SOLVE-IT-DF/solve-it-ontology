:techniqueT1086 a solveit-core:Technique ;
    rdfs:label "T1086: Timeline analysis"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/Timeline"^^xsd:anyURI,
        "https://ontology.solveit-df.org/solveit/observable/TimelineEntry"^^xsd:anyURI ;
    solveit-core:hasExample "PyDFT (Hargreaves & Patterson 2012)",
        "TimeSketch (Berggren et al. 2014)" ;
    solveit-core:hasPotentialWeakness :weaknessW1148,
        :weaknessW1266 ;
    solveit-core:hasReference "Berggren at al. (2014) TimeSketch, https://timesketch.org",
        "Breitinger, F., Studiawan, H. and Hargreaves, C., 2025. SoK: Timeline based event reconstruction for digital forensics: Terminology, methodology, and current challenges.",
        "Casey, E., 2011. Digital evidence and computer crime: Forensic science, computers, and the internet. Academic press, Section 8.1.2",
        "Hargreaves, C. and Patterson, J., 2012. An automated timeline reconstruction approach for digital forensic investigations. Digital Investigation, 9, pp.S69-S79." ;
    solveit-core:hasSubtechnique :techniqueT1134 ;
    solveit-core:hasSynonym "Temporal Analysis" ;
    solveit-core:techniqueDescription "The process of searching, filtering, sorting, highlighting, or aggregating timeline entries to determine which are relevant for event reconstruction, or to identify times of interest (adapted from Breitinger et al. 2025)" ;
    solveit-core:techniqueDetails "This can involve refinement approaches such as: filtering irrelevant entries, highlighting key entries, or aggregating entries into more meaningful events. This may result in a filtered timeline, or a set of highlighted timeline entries" ;
    solveit-core:techniqueID "T1086" ;
    solveit-core:techniqueName "Timeline analysis" .

