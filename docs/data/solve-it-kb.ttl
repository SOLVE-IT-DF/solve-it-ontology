:techniqueT1048 a solveit-core:Technique ;
    rdfs:label "T1048: Privacy protection via partial processing"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/RedactedArtifactSet"^^xsd:anyURI ;
    solveit-core:hasReference "Dickinson (2020) ‘Privacy by design – 10 ways MSAB can help you meet the challenges.’ MSAB Blog. Available at: https://www.msab.com/blog/privacy-by-design-10-ways-msab-can-help-you-meet-the-challenges/" ;
    solveit-core:techniqueDescription "Limiting the scope of file processing based on type, date or other criteria to protect privacy." ;
    solveit-core:techniqueDetails "The files may still be present in the data set or removed, or made in accessible but the core of the technique to to provide a limited set of artifacts, compared with full processing." ;
    solveit-core:techniqueID "T1048" ;
    solveit-core:techniqueName "Privacy protection via partial processing" .

:techniqueT1049 a solveit-core:Technique ;
    rdfs:label "T1049: Keyword searching"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/KeywordSearchResult"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1053,
        :weaknessW1058,
        :weaknessW1059,
        :weaknessW1196 ;
    solveit-core:hasReference "Beebe, N.L. and Clark, J.G., 2007. Digital forensic text string searching: Improving information retrieval effectiveness by thematically clustering search results. Digital investigation, 4, pp.49-54.",
        "Beebe, N.L. and Liu, L., 2014. Ranking algorithms for digital forensic string search hits. Digital Investigation, 11, pp.S124-S132.",
        "NIST, 2025. Computer forensics tools & techniques catalog: string search, https://toolcatalog.nist.gov/taxonomy/index.php?ff_id=31" ;
    solveit-core:hasSubtechnique :techniqueT1121,
        :techniqueT1122,
        :techniqueT1123,
        :techniqueT1124,
        :techniqueT1125,
        :techniqueT1126,
        :techniqueT1127,
        :techniqueT1151 ;
    solveit-core:hasSynonym "string search" ;
    solveit-core:techniqueDescription "This technique involves searching data in the case for specific strings" ;
    solveit-core:techniqueDetails "This search may be conducted live, directly over the data, or from a generated index of strings extracted from the data. The words searched for may be either case-specific, or sometimes case-type specific." ;
    solveit-core:techniqueID "T1049" ;
    solveit-core:techniqueName "Keyword searching" .

