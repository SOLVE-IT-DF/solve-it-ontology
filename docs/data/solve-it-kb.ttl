:techniqueT1054 a solveit-core:Technique ;
    rdfs:label "T1054: Manual content review for relevant material"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/analysis/ArtifactClassification"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/path"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1060,
        :weaknessW1061,
        :weaknessW1062 ;
    solveit-core:techniqueDescription "Manual examination of files or artifacts to determine their relevance to the investigation." ;
    solveit-core:techniqueDetails "The result of this process is a classification, which may be 'relevant', or could be more specific, e.g. 'contains reference to x'. This technique is likely paired with T1091 (Bookmark artifacts) but they could be recorded in other ways. This manual review could be of the content of files (T1058), or of content extracted from within files e.g. images (T1081), video (T1080), or audio (T1079)." ;
    solveit-core:techniqueID "T1054" ;
    solveit-core:techniqueName "Manual content review for relevant material" .

