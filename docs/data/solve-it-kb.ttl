    solveit-core:techniqueDetails "Web storage is a browser-based API bundled in HTML5 specifications that allow persistent client-side storage for web applications. (Mendoza 2015)" ;
    solveit-core:techniqueID "T1148" ;
    solveit-core:techniqueName "Browser web storage examination" .

:techniqueT1149 a solveit-core:Technique ;
    rdfs:label "T1149: File versioning feature examination"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/File"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/modifiedTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/version"^^xsd:anyURI ;
    solveit-core:hasExample "MacOS \"Revert to\" feature",
        "Volume Shadow Service (VSS)" ;
    solveit-core:hasReference "Apple (2025) View and restore past versions of documents on Mac https://support.apple.com/en-gb/guide/mac-help/mh40710/mac",
        "Hargreaves, C., Chivers, H. and Titheridge, D., 2008. Windows Vista and digital investigations. Digital Investigation, 5(1-2), pp.34-48.",
        "Leschke, T.R. and Nicholas, C., 2013, October. Change-link 2.0: a digital forensic tool for visualizing changes to shadow volume data. In Proceedings of the Tenth Workshop on Visualization for Cyber Security (pp. 17-24).",
        "Sreeja, S.C. and Balan, C., 2016, October. Forensic analysis of volume shadow copy in windows 7. In 2016 International Conference on Emerging Technological Trends (ICETT) (pp. 1-6). IEEE." ;
    solveit-core:hasSynonym "'Revert to...' feature examination",
        "macOS 'Versions' examination",
        "previous versions",
        "shadow copy examination" ;
    solveit-core:techniqueDescription "Extraction of data from the versioning system used by an operating system to store older versions of files." ;
    solveit-core:techniqueDetails "Operating systems often maintain versioning systems that preserve older versions of files, either for backup purposes or to enable users to restore previous states. These systems create snapshots or shadow copies at regular intervals or when significant changes occur. Digital forensic examination of these versioning features can reveal files that have been modified or deleted, providing valuable evidence of system activity and user behavior. The examination process involves identifying the versioning mechanism used by the operating system, locating the stored versions, and extracting relevant data for analysis." ;
    solveit-core:techniqueID "T1149" ;
    solveit-core:techniqueName "File versioning feature examination" .

:techniqueT1150 a solveit-core:Technique ;
    rdfs:label "T1150: Recover non-allocated files using residual file metadata"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/core/confidence"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/Directory"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/File"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/accessedTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/allocationStatus"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/creationTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/extInodeID"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/fileName"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/filePath"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/metadataChangeTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/mftFileID"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/mftFileNameAccessedTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/mftFileNameCreatedTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/mftFileNameModifiedTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/mftFileNameRecordChangeTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/mftRecordChangeTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/modifiedTime"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/ntfsOwnerID"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/ntfsOwnerSID"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/ownerSID"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1134,
        :weaknessW1135,
        :weaknessW1253,
        :weaknessW1254,
        :weaknessW1255,
        :weaknessW1256 ;
    solveit-core:hasReference "Carrier, B., 2005. File system forensic analysis. Addison-Wesley Professional.",
        "Casey, E., Nelson, A. and Hyde, J., 2019. Standardization of file recovery classification and authentication. Digital Investigation, 31, p.100873." ;
    solveit-core:techniqueDescription "Use metadata that remains in the file system to recover non-allocated files" ;
    solveit-core:techniqueID "T1150" ;
    solveit-core:techniqueName "Recover non-allocated files using residual file metadata" .

:techniqueT1151 a solveit-core:Technique ;
    rdfs:label "T1151: Keyword search (over extracted artifacts)"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/KeywordSearchResult"^^xsd:anyURI ;
    solveit-core:hasExample "Using Keywords with Magnet AXIOM (McQuaid 2017)" ;
    solveit-core:hasPotentialWeakness :weaknessW1257 ;
    solveit-core:hasReference "McQuaid, J. (2017) Using Keywords with Magnet AXIOM, Magnet Forensics, https://www.magnetforensics.com/blog/using-keywords-with-magnet-axiom/" ;
    solveit-core:hasSynonym "search artifacts only" ;
    solveit-core:techniqueDescription "Keyword searching only applied over extracted artifacts" ;
    solveit-core:techniqueDetails "This limited scope search may be performed within tools themselves e.g. McQuaid (2017), or within an exported packaged report." ;
    solveit-core:techniqueID "T1151" ;
    solveit-core:techniqueName "Keyword search (over extracted artifacts)" .

:techniqueT1154 a solveit-core:Technique ;
    rdfs:label "T1154: Identity-based event reconstruction"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/core/confidence"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/identity/Person"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/Account"^^xsd:anyURI ;
    solveit-core:hasReference "Casey, E. and Jaquet-Chiffelle, D.O., 2019. Do identities matter?. Policing: A Journal of Policy and Practice, 13(1), pp.21-34.",
        "Spichiger, H., 2025. Please mind the gap: A taxonomy for addressing the issue of linking person, account and device. Science & Justice, p.101314." ;
    solveit-core:hasSynonym "Resolving the person-account gap,",
        "Resolving the person-device gap" ;
    solveit-core:techniqueDescription "The process of attempting to link an identity (account, person etc.) to a reconstructed event" ;
    solveit-core:techniqueID "T1154" ;
    solveit-core:techniqueName "Identity-based event reconstruction" .

:techniqueT1155 a solveit-core:Technique ;
    rdfs:label "T1155: Operation-based event reconstruction"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/core/confidence"^^xsd:anyURI ;
    solveit-core:hasSynonym "Action-based event reconstruction",
        "Activity-based event reconstruction" ;
    solveit-core:techniqueDescription "The process of reconstructing that an operation occurred on a digital system" ;
    solveit-core:techniqueDetails """While some event reconstruction needs a time component, there are some questions that are simply explaining what happened, or if something happened. The time component may need to investigated later, or may be learned as a byproduct of reconstructing the event, but isn't intrinsic to the question being asked.
e.g. Was this file opened? How many times was this file opened? What data has been exfiltrated?""" ;
    solveit-core:techniqueID "T1155" ;
    solveit-core:techniqueName "Operation-based event reconstruction" .

:techniqueT1156 a solveit-core:Technique ;
    rdfs:label "T1156: Functional-based event reconstruction"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/configuration/Configuration"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/configuration/dependencies"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/core/confidence"^^xsd:anyURI ;
    solveit-core:techniqueDescription "Reconstructing the configuration or capabilities of a system at the time of an event" ;
    solveit-core:techniqueDetails """Considering how a system works and what conditions were necessary for an event to be possible, i.e. supporting or refuting if a hypothesis is feasible.

This might involve questions such as:
- is a program or system capable of performing some action
- how was the program or system configured (to determine if an operation was possible)""" ;
    solveit-core:techniqueID "T1156" ;
    solveit-core:techniqueName "Functional-based event reconstruction" .

:techniqueT1157 a solveit-core:Technique ;
    rdfs:label "T1157: Extract device data using exposed service"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/ArchiveFile"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/Call"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/Contact"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/File"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/SMSMessage"^^xsd:anyURI ;
    solveit-core:hasExample "Android Debug Bridge (ADB) provides command line access when USB debugging is enabled on Android devices",
        "Extraction of data by querying Content Providers on Android (via ADB)",
        "Extraction of data using AFC on iOS",
        "Media Transfer Protocol (MTP)" ;
    solveit-core:hasPotentialWeakness :weaknessW1037,
        :weaknessW1040,
        :weaknessW1041,
        :weaknessW1271,
        :weaknessW1272,
        :weaknessW1273 ;
    solveit-core:hasSubtechnique :techniqueT1019 ;
    solveit-core:techniqueDescription "Use an exposed service on a device to extract data. This represents several of the mobile data extraction methods e.g. Query content providers (android), AFC (iOS)." ;
    solveit-core:techniqueID "T1157" ;
    solveit-core:techniqueName "Extract device data using exposed service" .

:techniqueT1159 a solveit-core:Technique ;
    rdfs:label "T1159: Extract mobile data via deployed agent"@en ;
    solveit-core:hasExample "Belkasoft",
        "Elcomsoft" ;
    solveit-core:hasPotentialWeakness :weaknessW1276 ;
    solveit-core:hasReference "Belkasoft https://belkasoft.com/agent_based_ios_acquisition",
        "Elcomsoft 20203 https://blog.elcomsoft.com/2023/07/ios-device-acquisition-installing-the-extraction-agent/" ;
    solveit-core:techniqueDescription "Deploy software to a mobile device that can carry out some function, either collect data with available permissions or attempt further exploitation e.g. sandbox escape." ;
    solveit-core:techniqueDetails "While Android agents can be sideloaded with adb, deploying agents on iOS may require a developer account. Output may be equivalent of a file system acquisition if an exploit is successful. Otherwise data such as contacts would be extracted." ;
    solveit-core:techniqueID "T1159" ;
    solveit-core:techniqueName "Extract mobile data via deployed agent" .

:techniqueT1160 a solveit-core:Technique ;
    rdfs:label "T1160: Collect data with 'cloud backup restore' approach"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/SmartDevice"^^xsd:anyURI ;
    solveit-core:hasReference "Geus, J., Gruber, J., Wozar, J. and Freiling, F., 2025. From sync to seizure: A binary instrumentation-based evaluation of the iCloud backup process. Forensic Science International: Digital Investigation, 54, p.301978." ;
    solveit-core:techniqueDescription "Restore a device's cloud backup to a donor device, then subsequently use a local acquisition approach on that donor device, e.g. T1019/T1020" ;
    solveit-core:techniqueID "T1160" ;
    solveit-core:techniqueName "Collect data with 'cloud backup restore' approach" .

:techniqueT1162 a solveit-core:Technique ;
    rdfs:label "T1162: Read data from a device via In-System Programming (ISP)"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/Image"^^xsd:anyURI ;
    solveit-core:hasReference "https://en.wikipedia.org/wiki/In-system_programming" ;
    solveit-core:hasSubtechnique :techniqueT1027 ;
    solveit-core:hasSynonym "ISCP",
        "In-circuit serial Programming" ;
    solveit-core:techniqueID "T1162" ;
    solveit-core:techniqueName "Read data from a device via In-System Programming (ISP)" .

:techniqueT1163 a solveit-core:Technique ;
    rdfs:label "T1163: Automated screenshot-based capture of a mobile device"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/DeviceScreenshot"^^xsd:anyURI ;
    solveit-core:hasReference "https://github.com/prosch88/ALEX",
        "https://github.com/prosch88/UFADE" ;
    solveit-core:techniqueDescription "Programmatically controlling a mobile device while capturing screenshots of the display." ;
    solveit-core:techniqueID "T1163" ;
    solveit-core:techniqueName "Automated screenshot-based capture of a mobile device" .

