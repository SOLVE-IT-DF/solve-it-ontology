:techniqueT1031 a solveit-core:Technique ;
    rdfs:label "T1031: Key recovery from memory"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/DecryptionKey"^^xsd:anyURI ;
    solveit-core:hasExample "Bulk Extractor - of the many scanners within bulk extractor, one of which attempts to locate AES keys.",
        "Volatility - the plug in ‘trucryptmaster’ attempts to recover Truecrypt 7.1a master keys." ;
    solveit-core:hasPotentialWeakness :weaknessW1044,
        :weaknessW1045 ;
    solveit-core:hasReference "Halderman, J.A., Schoen, S.D., Heninger, N., Clarkson, W., Paul, W., Calandrino, J.A., Feldman, A.J., Appelbaum, J. and Felten, E.W., 2009. Lest we remember: cold-boot attacks on encryption keys. Communications of the ACM, 52(5), pp.91-98.",
        "Hargreaves & Chivers 2008b. Avoiding Live Imaging of Large Encrypted Volumes by Recovering Keys from Memory, Proceedings from 3rd Advances in Computer Security and Forensics ",
        "Hargreaves, C. and Chivers, H., 2008, March. Recovery of encryption keys from memory using a linear scan. In 2008 Third International Conference on Availability, Reliability and Security (pp. 1369-1376). IEEE." ;
    solveit-core:techniqueDescription "This describes the technique whereby an attempt is made to extract key material from memory, or a memory acquisition of a running system to fascinate the decryption of some data " ;
    solveit-core:techniqueID "T1031" ;
    solveit-core:techniqueName "Key recovery from memory" .

