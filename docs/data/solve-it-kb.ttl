@prefix : <https://ontology.solveit-df.org/solveit/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix solveit-core: <https://ontology.solveit-df.org/solveit/core/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:objective01 a solveit-core:Objective ;
    rdfs:label "Find potential digital evidence sources"@en ;
    solveit-core:includesTechnique :techniqueT1005,
        :techniqueT1006,
        :techniqueT1007,
        :techniqueT1008,
        :techniqueT1009 ;
    solveit-core:objectiveDescription "Locate sources of digital evidence that may be relevant to the investigation." ;
    solveit-core:objectiveName "Find potential digital evidence sources" .

:objective02 a solveit-core:Objective ;
    rdfs:label "Prioritize digital evidence sources"@en ;
    solveit-core:includesTechnique :techniqueT1001 ;
    solveit-core:objectiveDescription "Rank the evidence sources based on their relevance and potential value to the investigation." ;
    solveit-core:objectiveName "Prioritize digital evidence sources" .

:objective03 a solveit-core:Objective ;
    rdfs:label "Preserve digital evidence"@en ;
    solveit-core:includesTechnique :techniqueT1010,
        :techniqueT1011,
        :techniqueT1012,
        :techniqueT1013,
        :techniqueT1110 ;
    solveit-core:objectiveDescription "Ensure the integrity and authenticity of digital evidence is maintained." ;
    solveit-core:objectiveName "Preserve digital evidence" .

:objective04 a solveit-core:Objective ;
    rdfs:label "Acquire data"@en ;
    solveit-core:includesTechnique :techniqueT1002,
        :techniqueT1003,
        :techniqueT1004,
        :techniqueT1015,
        :techniqueT1016,
        :techniqueT1017,
        :techniqueT1018,
        :techniqueT1020,
        :techniqueT1022,
        :techniqueT1023,
        :techniqueT1024,
        :techniqueT1025,
        :techniqueT1026,
        :techniqueT1028,
        :techniqueT1029,
        :techniqueT1030,
        :techniqueT1104,
        :techniqueT1111,
        :techniqueT1112,
        :techniqueT1113,
        :techniqueT1114,
        :techniqueT1157,
        :techniqueT1159,
        :techniqueT1160,
        :techniqueT1162,
        :techniqueT1163 ;
    solveit-core:objectiveDescription "Collect data from the identified evidence sources." ;
    solveit-core:objectiveName "Acquire data" .

:objective05 a solveit-core:Objective ;
    rdfs:label "Gain access"@en ;
    solveit-core:includesTechnique :techniqueT1031,
        :techniqueT1032,
        :techniqueT1033,
        :techniqueT1034,
        :techniqueT1035,
        :techniqueT1036,
        :techniqueT1037,
        :techniqueT1038,
        :techniqueT1039,
        :techniqueT1040,
        :techniqueT1041,
        :techniqueT1158 ;
    solveit-core:objectiveDescription "Attempt to gain access to protected data sources or other restricted data." ;
    solveit-core:objectiveName "Gain access" .

:objective06 a solveit-core:Objective ;
    rdfs:label "Read data from digital evidence storage formats"@en ;
    solveit-core:includesTechnique :techniqueT1042,
        :techniqueT1043,
        :techniqueT1044,
        :techniqueT1045,
        :techniqueT1102 ;
    solveit-core:objectiveDescription "Access data within digital evidence containers such as disk images, memory dumps, or archive formats." ;
    solveit-core:objectiveName "Read data from digital evidence storage formats" .

:objective07 a solveit-core:Objective ;
    rdfs:label "Reduce data under consideration"@en ;
    solveit-core:includesTechnique :techniqueT1046,
        :techniqueT1047,
        :techniqueT1048 ;
    solveit-core:objectiveDescription "Filter the data to be considered in the investigation for practical, legal, or privacy protection reasons." ;
    solveit-core:objectiveName "Reduce data under consideration" .

:objective08 a solveit-core:Objective ;
    rdfs:label "Access partitions, volumes and file systems data"@en ;
    solveit-core:includesTechnique :techniqueT1059,
        :techniqueT1060,
        :techniqueT1061,
        :techniqueT1062,
        :techniqueT1063 ;
    solveit-core:objectiveDescription "Process core data storage structures such as partitions, volumes, and file systems, recovering content and metadata." ;
    solveit-core:objectiveName "Access partitions, volumes and file systems data" .

:objective09 a solveit-core:Objective ;
    rdfs:label "Extract artifacts stored by the operating system"@en ;
    solveit-core:includesTechnique :techniqueT1065,
        :techniqueT1066,
        :techniqueT1067,
        :techniqueT1068,
        :techniqueT1083,
        :techniqueT1096,
        :techniqueT1097,
        :techniqueT1098,
        :techniqueT1116,
        :techniqueT1149 ;
    solveit-core:objectiveDescription "Process data stored by the operating system to extract digital forensic artifacts." ;
    solveit-core:objectiveName "Extract artifacts stored by the operating system" .

:objective10 a solveit-core:Objective ;
    rdfs:label "Extract artifacts stored by applications"@en ;
    solveit-core:includesTechnique :techniqueT1069,
        :techniqueT1070,
        :techniqueT1072,
        :techniqueT1073,
        :techniqueT1074,
        :techniqueT1075,
        :techniqueT1077,
        :techniqueT1078,
        :techniqueT1105,
        :techniqueT1107,
        :techniqueT1108,
        :techniqueT1109,
        :techniqueT1133 ;
    solveit-core:objectiveDescription "Process data stored by the applications to extract digital forensic artifacts." ;
    solveit-core:objectiveName "Extract artifacts stored by applications" .

:objective11 a solveit-core:Objective ;
    rdfs:label "Extract artifacts, or content of specific types"@en ;
    solveit-core:includesTechnique :techniqueT1021,
        :techniqueT1052,
        :techniqueT1053,
        :techniqueT1056,
        :techniqueT1071,
        :techniqueT1076,
        :techniqueT1099,
        :techniqueT1100,
        :techniqueT1120 ;
    solveit-core:objectiveDescription "Process data to extract artifacts or stored content of specific types." ;
    solveit-core:objectiveName "Extract artifacts, or content of specific types" .

:objective12 a solveit-core:Objective ;
    rdfs:label "Locate potentially relevant content"@en ;
    solveit-core:includesTechnique :techniqueT1049,
        :techniqueT1050,
        :techniqueT1051,
        :techniqueT1086,
        :techniqueT1118 ;
    solveit-core:objectiveDescription "Attempt to find digital artifacts relevant to the investigation." ;
    solveit-core:objectiveName "Locate potentially relevant content" .

:objective13 a solveit-core:Objective ;
    rdfs:label "Review content for relevance"@en ;
    solveit-core:includesTechnique :techniqueT1054,
        :techniqueT1055,
        :techniqueT1079,
        :techniqueT1080,
        :techniqueT1081,
        :techniqueT1082 ;
    solveit-core:objectiveDescription "Review potentially relevant content to determine its significance or meaning." ;
    solveit-core:objectiveName "Review content for relevance" .

:objective14 a solveit-core:Objective ;
    rdfs:label "Detect anti-forensics and other anomalies"@en ;
    solveit-core:includesTechnique :techniqueT1057,
        :techniqueT1058,
        :techniqueT1128,
        :techniqueT1129,
        :techniqueT1130,
        :techniqueT1131,
        :techniqueT1132 ;
    solveit-core:objectiveDescription "Search for indicators of anti-forensic techniques or other anomalies such as malware, which could affect interpretation." ;
    solveit-core:objectiveName "Detect anti-forensics and other anomalies" .

:objective15 a solveit-core:Objective ;
    rdfs:label "Establish identities"@en ;
    solveit-core:includesTechnique :techniqueT1084,
        :techniqueT1085 ;
    solveit-core:objectiveDescription "Attempt to link data or devices to individuals." ;
    solveit-core:objectiveName "Establish identities" .

:objective16 a solveit-core:Objective ;
    rdfs:label "Create visualizations"@en ;
    solveit-core:includesTechnique :techniqueT1103,
        :techniqueT1115 ;
    solveit-core:objectiveDescription "Display information using visual representations to assist with analysis." ;
    solveit-core:objectiveName "Create visualizations" .

:objective17 a solveit-core:Objective ;
    rdfs:label "Reconstruct events"@en ;
    solveit-core:includesTechnique :techniqueT1087,
        :techniqueT1088,
        :techniqueT1117,
        :techniqueT1154,
        :techniqueT1155,
        :techniqueT1156 ;
    solveit-core:objectiveDescription "Use available digital evidence to formulate and test hypotheses about events." ;
    solveit-core:objectiveName "Reconstruct events" .

:objective18 a solveit-core:Objective ;
    rdfs:label "Conduct research"@en ;
    solveit-core:includesTechnique :techniqueT1089,
        :techniqueT1090,
        :techniqueT1095,
        :techniqueT1101,
        :techniqueT1119 ;
    solveit-core:objectiveDescription "Conduct research to gain additional knowledge to support the acquisition, extraction, or interpretation of digital evidence." ;
    solveit-core:objectiveName "Conduct research" .

:objective19 a solveit-core:Objective ;
    rdfs:label "Produce documentation"@en ;
    solveit-core:includesTechnique :techniqueT1014,
        :techniqueT1091,
        :techniqueT1092,
        :techniqueT1093,
        :techniqueT1094 ;
    solveit-core:objectiveDescription "Create documentation about techniques used and findings." ;
    solveit-core:objectiveName "Produce documentation" .

:techniqueT1000 a solveit-core:Technique ;
    rdfs:label "T1000: Placeholder"@en ;
    solveit-core:techniqueID "T1000" ;
    solveit-core:techniqueName "Placeholder" .

:weaknessW1150 a solveit-core:Weakness ;
    rdfs:label "W1150: Misinterpreting events from automated processes as user generated ones"@en ;
    solveit-core:hasReference "Jens-Petter Sandvik, André Årnes, 2018. The reliability of clocks as digital evidence under low voltage conditions. Digital Investigation, 24, pp.S10-S17." ;
    solveit-core:mayResultInINAC_ALT false ;
    solveit-core:mayResultInINAC_AS false ;
    solveit-core:mayResultInINAC_COR false ;
    solveit-core:mayResultInINAC_EX true ;
    solveit-core:mayResultInINCOMP false ;
    solveit-core:mayResultInMISINT true ;
    solveit-core:weaknessID "W1150" ;
    solveit-core:weaknessName "Misinterpreting events from automated processes as user generated ones" .

:weaknessW1181 a solveit-core:Weakness ;
    rdfs:label "W1181: Failure to decrypt internal disk using a bootable environment"@en ;
    solveit-core:mayResultInINAC_ALT false ;
    solveit-core:mayResultInINAC_AS false ;
    solveit-core:mayResultInINAC_COR false ;
    solveit-core:mayResultInINAC_EX false ;
    solveit-core:mayResultInINCOMP true ;
    solveit-core:mayResultInMISINT false ;
    solveit-core:weaknessID "W1181" ;
    solveit-core:weaknessName "Failure to decrypt internal disk using a bootable environment" .

:weaknessW1182 a solveit-core:Weakness ;
    rdfs:label "W1182: Bootable environment overwrites relevant data on the target device"@en ;
    solveit-core:hasPotentialMitigation :mitigationM1008,
        :mitigationM1014,
        :mitigationM1015 ;
    solveit-core:mayResultInINAC_ALT false ;
    solveit-core:mayResultInINAC_AS false ;
    solveit-core:mayResultInINAC_COR true ;
    solveit-core:mayResultInINAC_EX false ;
    solveit-core:mayResultInINCOMP true ;
    solveit-core:mayResultInMISINT false ;
    solveit-core:weaknessID "W1182" ;
    solveit-core:weaknessName "Bootable environment overwrites relevant data on the target device" .

:mitigationM1001 a solveit-core:Mitigation ;
    rdfs:label "M1001: Review of all triage results that are relied on during the full digital forensic examination"@en ;
    solveit-core:mitigationID "M1001" ;
