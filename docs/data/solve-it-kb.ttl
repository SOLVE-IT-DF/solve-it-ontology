    rdfs:label "M1018: Check if presence of SD card is expected"@en ;
    solveit-core:mitigationID "M1018" ;
    solveit-core:mitigationName "Check if presence of SD card is expected" .

:mitigationM1019 a solveit-core:Mitigation ;
    rdfs:label "M1019: Consider if file system acquisition is possible/permitted"@en ;
