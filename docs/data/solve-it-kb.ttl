    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/ArchiveFile"^^xsd:anyURI ;
    solveit-core:techniqueID "T1023" ;
    solveit-core:techniqueName "Cloud data collection to access data via a live web page using credentials" .

:techniqueT1024 a solveit-core:Technique ;
    rdfs:label "T1024: Cloud data collection via submission of request to service provider"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/ArchiveFile"^^xsd:anyURI ;
    solveit-core:techniqueID "T1024" ;
    solveit-core:techniqueName "Cloud data collection via submission of request to service provider" .

:techniqueT1025 a solveit-core:Technique ;
    rdfs:label "T1025: Writing data to a forensic image format"@en ;
    solveit-core:hasCASEInputClass "https://ontology.solveit-df.org/solveit/observable/BitstreamData"^^xsd:anyURI,
        "https://ontology.solveit-df.org/solveit/observable/FileSet"^^xsd:anyURI ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/ForensicImageContainer"^^xsd:anyURI,
        "https://ontology.solveit-df.org/solveit/observable/RawImageFile"^^xsd:anyURI ;
    solveit-core:hasExample "2009 M57-Jean - Data is supplied as a ‘multi-volume Expert Witness file’ - i.e. split EnCase E01 & E02 image files (https://digitalcorpora.org/corpora/scenarios/m57-jean/)",
        "FTK Imager: This tool can be used to acquire data from block devices in various image formats including RAW, EWF, and AFF",
        "Magnet Acquire: This tool can be used to acquire data from block devices in various image formats including RAW and EWF.",
        "libewf: This open source library allows access to the EWF format. The accompanying ewftools proves tools to verify, inspect and create EWF images. " ;
    solveit-core:hasPotentialWeakness :weaknessW1043 ;
    solveit-core:hasSynonym "Disk image container",
        "image file" ;
    solveit-core:techniqueDescription "Storage of data recovered from a digital device in various formats which might include bitstream data or a logical set of files" ;
    solveit-core:techniqueDetails "Bitstream data that would result from disk imaging would be stored in formats such as: RAW, EWF, AFF4. For sets of files that are extracted there are proprietary logical formats from tool vendors. The imaged data may be split into several linked container formats. e.g. e01, e02 e03 etc." ;
    solveit-core:techniqueID "T1025" ;
    solveit-core:techniqueName "Writing data to a forensic image format" .

:techniqueT1026 a solveit-core:Technique ;
    rdfs:label "T1026: Writing data to standard archive format"@en ;
