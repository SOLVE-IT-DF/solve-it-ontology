:techniqueT1022 a solveit-core:Technique ;
    rdfs:label "T1022: Mobile device screenshot based capture"@en ;
    solveit-core:hasReference "Fukami, A., Stoykova, R. and Geradts, Z., 2021. A new model for forensic data extraction from encrypted mobile devices. Forensic Science International: Digital Investigation, 38, p.301169." ;
    solveit-core:techniqueDescription "An examiner directly manipulates the target mobile device using the device's input interface (i.e., keypads and buttons), and records the content shown on the display of the device. (Fukami et al 2021)" ;
    solveit-core:techniqueID "T1022" ;
