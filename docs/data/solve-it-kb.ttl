:techniqueT1034 a solveit-core:Technique ;
    rdfs:label "T1034: Brute force attack"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/password"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1140,
        :weaknessW1141,
        :weaknessW1142 ;
    solveit-core:hasReference "Kanta, A., Coray, S., Coisel, I. and Scanlon, M., 2021. How viable is password cracking in digital forensic investigation? Analyzing the guessability of over 3.9 billion real-world accounts. Forensic Science International: Digital Investigation, 37, p.301186." ;
    solveit-core:hasSynonym "exhaustive password search" ;
    solveit-core:techniqueDescription "A brute force attack, or exhaustive search is a password cracking approach where every combination of characters is tested until the correct one is found. This method is \"guaranteed to work\" given infinite time and resources which in a real-life scenario is not feasible." ;
    solveit-core:techniqueDetails "Brute force attack involves trying every possible combination in a defined search space to find the correct value. The search space could be limited to just numbers, for example in the case of a 4-digit PIN number, or alphanumerical values or even the full ASCII character set. The larger the search space, the longer it takes to complete a brute force attack." ;
    solveit-core:techniqueID "T1034" ;
    solveit-core:techniqueName "Brute force attack" .

:techniqueT1037 a solveit-core:Technique ;
    rdfs:label "T1037: Obtain password from the device owner"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/password"^^xsd:anyURI ;
    solveit-core:techniqueID "T1037" ;
    solveit-core:techniqueName "Obtain password from the device owner" .

:techniqueT1040 a solveit-core:Technique ;
    rdfs:label "T1040: Use mobile device exploit"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/isPrivileged"^^xsd:anyURI ;
    solveit-core:hasExample "",
        "Checkra1n, https://checkra.in" ;
    solveit-core:hasPotentialWeakness :weaknessW1157,
        :weaknessW1158 ;
    solveit-core:hasReference "Grover, J., 2013. Android forensics: Automated data collection and reporting from a mobile device. Digital Investigation, 10, pp.S12-S20." ;
    solveit-core:techniqueDescription "A process that typically exploits a security flaw in a specific device or operating system to enable users to perform higher privileged functions on a device (derived from Grover 2013)" ;
    solveit-core:techniqueID "T1040" ;
    solveit-core:techniqueName "Use mobile device exploit" .

:techniqueT1125 a solveit-core:Technique ;
    rdfs:label "T1125: Keyword search (live)"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/KeywordSearchResult"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1200 ;
    solveit-core:hasReference "NIST, 2025. Computer forensics tools & techniques catalog: string search, https://toolcatalog.nist.gov/taxonomy/index.php?ff_id=31",
        "X-Ways (2025), X-Ways Manual: Logical Search (section 5.11), https://www.x-ways.net/winhex/manual.pdf",
        "X-Ways (2025), X-Ways Manual: Simultaneous Search (section 5.10), https://www.x-ways.net/winhex/manual.pdf" ;
    solveit-core:hasSynonym "live search" ;
    solveit-core:techniqueDescription "Searching for keywords over the raw data in a case without using an index of text content" ;
    solveit-core:techniqueDetails "This may be done on a physical sector basis, or on a logical (file) basis." ;
    solveit-core:techniqueID "T1125" ;
    solveit-core:techniqueName "Keyword search (live)" .

