    solveit-core:mitigationName "Testing of retrieval of indexed content" .

:mitigationM1035 a solveit-core:Mitigation ;
    rdfs:label "M1035: Verification against second tool with known different regex implementation"@en ;
    solveit-core:mitigationID "M1035" ;
    solveit-core:mitigationName "Verification against second tool with known different regex implementation" .

:mitigationM1036 a solveit-core:Mitigation ;
    rdfs:label "M1036: Testing of regular expression component of tool"@en ;
    solveit-core:mitigationID "M1036" ;
    solveit-core:mitigationName "Testing of regular expression component of tool" .

:mitigationM1037 a solveit-core:Mitigation ;
    rdfs:label "M1037: The context of relevant keyword results are manually checked"@en ;
    solveit-core:mitigationID "M1037" ;
    solveit-core:mitigationName "The context of relevant keyword results are manually checked" .

:mitigationM1043 a solveit-core:Mitigation ;
    rdfs:label "M1043: Scan for orphaned EPTs"@en ;
    solveit-core:hasReference "X-Ways - Provides an option called ‘Scan for Lost Partitions’ which explicitly scans for deleted partitions in unallocated space (X-Ways 2024)" ;
    solveit-core:mitigationID "M1043" ;
    solveit-core:mitigationName "Scan for orphaned EPTs" .

:mitigationM1044 a solveit-core:Mitigation ;
    rdfs:label "M1044: Scan for Volume Boot Records in unpartitioned space"@en ;
    solveit-core:hasReference "X-Ways - Provides an option called ‘Scan for Lost Partitions’ which explicitly scans for deleted partitions in unallocated space (X-Ways 2024)" ;
    solveit-core:mitigationID "M1044" ;
    solveit-core:mitigationName "Scan for Volume Boot Records in unpartitioned space" .

:mitigationM1045 a solveit-core:Mitigation ;
    rdfs:label "M1045: Explicitly detect sector size in use"@en ;
    solveit-core:mitigationID "M1045" ;
    solveit-core:mitigationName "Explicitly detect sector size in use" .

:mitigationM1046 a solveit-core:Mitigation ;
    rdfs:label "M1046: Check pointer offsets for both 512 and 4096 sectors sizes"@en ;
    solveit-core:mitigationID "M1046" ;
    solveit-core:mitigationName "Check pointer offsets for both 512 and 4096 sectors sizes" .

:mitigationM1048 a solveit-core:Mitigation ;
    rdfs:label "M1048: Check built-in integrity checks of partition tables where possible"@en ;
    solveit-core:mitigationID "M1048" ;
    solveit-core:mitigationName "Check built-in integrity checks of partition tables where possible" .

:mitigationM1049 a solveit-core:Mitigation ;
    rdfs:label "M1049: Check consistency between primary and backup partition tables (where possible)"@en ;
    solveit-core:mitigationID "M1049" ;
    solveit-core:mitigationName "Check consistency between primary and backup partition tables (where possible)" .

:mitigationM1059 a solveit-core:Mitigation ;
    rdfs:label "M1059: Ongoing research and documentation of syncronisation artefacts"@en ;
    solveit-core:mitigationID "M1059" ;
    solveit-core:mitigationName "Ongoing research and documentation of syncronisation artefacts" .

:mitigationM1060 a solveit-core:Mitigation ;
    rdfs:label "M1060: Repair salvaged content by grafting different reference data onto fragment(s)"@en ;
    solveit-core:linksToTechnique :techniqueT1099 ;
    solveit-core:mitigationID "M1060" ;
    solveit-core:mitigationName "Repair salvaged content by grafting different reference data onto fragment(s)" .

:mitigationM1061 a solveit-core:Mitigation ;
    rdfs:label "M1061: Use digital stratigraphy to attempt to attribute data within a specific file system"@en ;
    solveit-core:hasReference "Schneider, J., Eichhorn, M., Dreier, L.M. and Hargreaves, C., 2024. Applying digital stratigraphy to the problem of recycled storage media. Forensic Science International: Digital Investigation, 49, p.301761." ;
    solveit-core:mitigationID "M1061" ;
    solveit-core:mitigationName "Use digital stratigraphy to attempt to attribute data within a specific file system" .

:mitigationM1065 a solveit-core:Mitigation ;
    rdfs:label "M1065: Render salvaged content by reconstructing a container around fragment(s) based on detected video frame and audio sample locations and (if available) a reference video file with similar parameters."@en ;
    solveit-core:mitigationID "M1065" ;
    solveit-core:mitigationName "Render salvaged content by reconstructing a container around fragment(s) based on detected video frame and audio sample locations and (if available) a reference video file with similar parameters." .

:mitigationM1066 a solveit-core:Mitigation ;
    rdfs:label "M1066: Attempt to reconstruct browser activity from other areas of disk"@en ;
    solveit-core:hasReference "Chivers, H., 2014. Private browsing: A window of forensic opportunity. Digital Investigation, 11(1), pp.20-29." ;
    solveit-core:mitigationID "M1066" ;
    solveit-core:mitigationName "Attempt to reconstruct browser activity from other areas of disk" .

:mitigationM1067 a solveit-core:Mitigation ;
    rdfs:label "M1067: Analyze web browser memory for web browsing activity"@en ;
    solveit-core:hasReference "Chivers, H., 2014. Private browsing: A window of forensic opportunity. Digital Investigation, 11(1), pp.20-29." ;
    solveit-core:linksToTechnique :techniqueT1105 ;
    solveit-core:mitigationID "M1067" ;
    solveit-core:mitigationName "Analyze web browser memory for web browsing activity" .

:mitigationM1068 a solveit-core:Mitigation ;
    rdfs:label "M1068: Use digital sniffer dogs to assist in locating evidence"@en ;
    solveit-core:hasReference "Petersen, S.J. and Schoon, A., 2022. Dogs as Detectors for Hidden Digital Storage Devices: A Pilot Study from the National Police of The Netherlands. In Canines (pp. 535-557). Jenny Stanford Publishing." ;
    solveit-core:linksToTechnique :techniqueT1006 ;
    solveit-core:mitigationID "M1068" ;
    solveit-core:mitigationName "Use digital sniffer dogs to assist in locating evidence" .

:mitigationM1069 a solveit-core:Mitigation ;
    rdfs:label "M1069: Use a SyncTriage style approach to determine existence other synchronized devices"@en ;
    solveit-core:hasReference "Hargreaves, C. and Marshall, A., 2019. SyncTriage: Using synchronisation artefacts to optimise acquisition order. Digital Investigation, 28, pp.S134-S140." ;
    solveit-core:linksToTechnique :techniqueT1007 ;
    solveit-core:mitigationID "M1069" ;
    solveit-core:mitigationName "Use a SyncTriage style approach to determine existence other synchronized devices" .

:mitigationM1070 a solveit-core:Mitigation ;
    rdfs:label "M1070: Ensure hash algorithm(s) used are resistant to collisions through data manipulation"@en ;
    solveit-core:mitigationID "M1070" ;
    solveit-core:mitigationName "Ensure hash algorithm(s) used are resistant to collisions through data manipulation" .

:mitigationM1071 a solveit-core:Mitigation ;
    rdfs:label "M1071: Thorough testing of write blocker against multiple targets to ensure that writes are not possible."@en ;
    solveit-core:hasReference "Lyle, J.R., 2006. A strategy for testing hardware write block devices. digital investigation, 3, pp.3-9." ;
    solveit-core:mitigationID "M1071" ;
    solveit-core:mitigationName "Thorough testing of write blocker against multiple targets to ensure that writes are not possible." .

:mitigationM1072 a solveit-core:Mitigation ;
    rdfs:label "M1072: Regular checks for hardware write blocker firmware updates."@en ;
    solveit-core:mitigationID "M1072" ;
    solveit-core:mitigationName "Regular checks for hardware write blocker firmware updates." .

:mitigationM1073 a solveit-core:Mitigation ;
    rdfs:label "M1073: Subscription to notifications from write blocker vendor for firmware updates or identified problems."@en ;
    solveit-core:mitigationID "M1073" ;
    solveit-core:mitigationName "Subscription to notifications from write blocker vendor for firmware updates or identified problems." .

:mitigationM1074 a solveit-core:Mitigation ;
    rdfs:label "M1074: Validate image hash against one stored externally to the image in a trusted location."@en ;
    solveit-core:hasReference "Hargreaves, C., Nelson, A. and Casey, E., 2024. An abstract model for digital forensic analysis tools-A foundation for systematic error mitigation analysis. Forensic Science International: Digital Investigation, 48, p.301679." ;
    solveit-core:mitigationID "M1074" ;
    solveit-core:mitigationName "Validate image hash against one stored externally to the image in a trusted location." .

:mitigationM1076 a solveit-core:Mitigation ;
    rdfs:label "M1076: Testing programme to validate hashes of metadata in images is calculated correctly"@en ;
    solveit-core:mitigationID "M1076" ;
    solveit-core:mitigationName "Testing programme to validate hashes of metadata in images is calculated correctly" .

:mitigationM1077 a solveit-core:Mitigation ;
    rdfs:label "M1077: Ensure potential secondary locations for stored message content are reviewed."@en ;
    solveit-core:hasReference "McGee, J. (2022). An Alternate Location for Deleted SMS/iMessage Data in Apple Devices. DFIR Review. Retrieved from https://dfir.pubpub.org/pub/yp6efc8q" ;
    solveit-core:mitigationID "M1077" ;
    solveit-core:mitigationName "Ensure potential secondary locations for stored message content are reviewed." .

:mitigationM1078 a solveit-core:Mitigation ;
    rdfs:label "M1078: Use of multiple carving tools and comparing results"@en ;
    solveit-core:mitigationID "M1078" ;
    solveit-core:mitigationName "Use of multiple carving tools and comparing results" .

:mitigationM1084 a solveit-core:Mitigation ;
    rdfs:label "M1084: Test that the tool used expresses uncertainty in the classification of file recovery results"@en ;
    solveit-core:mitigationID "M1084" ;
    solveit-core:mitigationName "Test that the tool used expresses uncertainty in the classification of file recovery results" .

:mitigationM1086 a solveit-core:Mitigation ;
    rdfs:label "M1086: Acquire the parts of memory with interconnected data first, before proceeding with a sequential acquisition."@en ;
    solveit-core:hasReference "Pagani, F., Fedorov, O. and Balzarotti, D., 2019. Introducing the temporal dimension to memory forensics. ACM Transactions on Privacy and Security (TOPS), 22(2), 1-21." ;
    solveit-core:mitigationID "M1086" ;
    solveit-core:mitigationName "Acquire the parts of memory with interconnected data first, before proceeding with a sequential acquisition." .

:mitigationM1087 a solveit-core:Mitigation ;
    rdfs:label "M1087: Acquire memory from outside of the target system for example using direct memory access (DMA) devices"@en ;
    solveit-core:hasReference "Latzo, T., Palutke, R. and Freiling, F., 2019. A universal taxonomy and survey of forensic memory acquisition techniques. Digital Investigation, 28, 56-69." ;
