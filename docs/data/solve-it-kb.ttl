:techniqueT1006 a solveit-core:Technique ;
    rdfs:label "T1006: Digital sniffer dogs"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/Device"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/location"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1005 ;
    solveit-core:hasReference "Petersen, S.J. and Schoon, A., 2022. Dogs as Detectors for Hidden Digital Storage Devices: A Pilot Study from the National Police of The Netherlands. In Canines (pp. 535-557). Jenny Stanford Publishing." ;
    solveit-core:hasSynonym "Digital Storage Device Dogs" ;
    solveit-core:techniqueDescription "The use of canines to locate obscured digital storage devices." ;
    solveit-core:techniqueID "T1006" ;
    solveit-core:techniqueName "Digital sniffer dogs" .

:techniqueT1007 a solveit-core:Technique ;
    rdfs:label "T1007: Use a SyncTriage-based approach to detect existence of devices"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/Device"^^xsd:anyURI ;
    solveit-core:hasExample "SyncTriage - https://bitbucket.org/chrishargreaves/synctriage" ;
    solveit-core:hasPotentialWeakness :weaknessW1008,
        :weaknessW1009,
        :weaknessW1010,
        :weaknessW1011,
        :weaknessW1012 ;
    solveit-core:hasReference "Hargreaves, C. and Marshall, A., 2019. SyncTriage: Using synchronisation artefacts to optimise acquisition order. Digital Investigation, 28, pp.S134-S140." ;
    solveit-core:techniqueDescription "A technique developed in Hargreaves & Marshall (2018) whereby synchronisation artefacts on a device are examined and used to identify the existence of a related device. Also sometimes used to infer activity that occurred on an inaccessible or unavailable device. " ;
    solveit-core:techniqueID "T1007" ;
    solveit-core:techniqueName "Use a SyncTriage-based approach to detect existence of devices" .

:techniqueT1012 a solveit-core:Technique ;
    rdfs:label "T1012: Connect storage medium via hardware write blocker"@en ;
    solveit-core:hasCASEInputClass "https://ontology.unifiedcyberontology.org/uco/observable/StorageMedium"^^xsd:anyURI ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/WriteProtectedDeviceInterface"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1118,
        :weaknessW1119,
        :weaknessW1120 ;
    solveit-core:hasReference "Lyle, J.R., 2006. A strategy for testing hardware write block devices. digital investigation, 3, pp.3-9." ;
    solveit-core:techniqueDescription "A hardware write blocking device [should] prevent any change to data in the user area of a hard drive while allowing access to all data on a hard drive. (Lyle 2006)" ;
    solveit-core:techniqueDetails "Note that \"Sometimes it may be desirable to change a drive configuration to obtain access to otherwise hidden sectors, for example, such as within an HPA (host protected area).\" (Lyle 2006) " ;
    solveit-core:techniqueID "T1012" ;
    solveit-core:techniqueName "Connect storage medium via hardware write blocker" .

:techniqueT1013 a solveit-core:Technique ;
    rdfs:label "T1013: Use software write blockers to provide read only access to storage media"@en ;
    solveit-core:hasCASEInputClass "https://ontology.solveit-df.org/solveit/observable/DeviceInterface"^^xsd:anyURI ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/WriteProtectedDeviceInterface"^^xsd:anyURI ;
    solveit-core:hasReference "NIST (2006) NIST SP 800-86 Guide to Integrating Forensic Techniques into Incident Response, https://doi.org/10.6028/NIST.SP.800-86" ;
    solveit-core:techniqueDescription "Use of a software-based tool that prevents a computer from writing to computer storage media connected to it (NIST 2006)" ;
    solveit-core:techniqueID "T1013" ;
    solveit-core:techniqueName "Use software write blockers to provide read only access to storage media" .

:techniqueT1020 a solveit-core:Technique ;
    rdfs:label "T1020: Mobile file system extraction"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/ArchiveFile"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1159,
        :weaknessW1160,
        :weaknessW1161,
        :weaknessW1162,
        :weaknessW1163,
        :weaknessW1164 ;
    solveit-core:hasReference "Cellebrite (undated), Full File System Extraction - Mobile Device Forensics, https://cellebrite.com/en/glossary/full-file-system-extraction-mobile-device-forensics/",
        "Fukami, A., Stoykova, R. and Geradts, Z., 2021. A new model for forensic data extraction from encrypted mobile devices. Forensic Science International: Digital Investigation, 38, p.301169.",
        "Magnet (2024) Revealing hidden data: Full file system extractions uncovered, https://www.magnetforensics.com/blog/revealing-hidden-data-full-file-system-extractions-uncovered/" ;
    solveit-core:techniqueDescription "Accessing the file system(s) of the device and extracting a set of files (full or partial depending on level of access)" ;
    solveit-core:techniqueDetails "Note that Fukami et al (2021) states \"In order to conduct effective file system extraction, rooting the device is required.\" See T1040. Usually results in a zip/tar file. Rooting may provide access to the file system, but files may still be encrypted. Attacking the user pin, usually on device, using T1034, or T1035 may be necessary, unless the PIN can be obtained from the device user (T1037)" ;
    solveit-core:techniqueID "T1020" ;
    solveit-core:techniqueName "Mobile file system extraction" .

:techniqueT1033 a solveit-core:Technique ;
    rdfs:label "T1033: Extraction of credential from an accessible device"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/Account"^^xsd:anyURI ;
    solveit-core:techniqueDescription "Accessing a device with limited or no security to obtain a credential (e.g. password, PIN, token) that can be used to access another device or service." ;
    solveit-core:techniqueID "T1033" ;
    solveit-core:techniqueName "Extraction of credential from an accessible device" .

:techniqueT1042 a solveit-core:Technique ;
    rdfs:label "T1042: Disk image hash verification"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/hash"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1042,
        :weaknessW1124,
        :weaknessW1125,
        :weaknessW1126,
        :weaknessW1127,
        :weaknessW1128 ;
    solveit-core:hasReference "Kessler GC. The impact of SHA-1 file hash collisions on digital forensic imaging: A follow-up experiment. Journal of Digital Forensics, Security and Law. 2016;11(4):10.",
        "Kessler, G.C., 2016. The impact of MD5 file hash collisions on digital forensic imaging. Journal of digital forensics, security and law, 11(4), p.9.",
        "Lyle, J., 2002. Testing disk imaging tools. DFRWS USA 2002, https://dfrws.org/wp-content/uploads/2019/06/2002_USA_paper-testing_disk_imaging_tools.pdf" ;
    solveit-core:techniqueDescription "Computing the hash function of the entire contents of a disk, recording it, and then subsequently computing the hash over any disk image created to detect if any content is different (adapted from Lyle 2002)" ;
    solveit-core:techniqueID "T1042" ;
    solveit-core:techniqueName "Disk image hash verification" .

