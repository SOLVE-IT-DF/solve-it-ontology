    solveit-core:hasPotentialWeakness :weaknessW1165,
        :weaknessW1275 ;
    solveit-core:techniqueDescription "Storing acquired data in a standard archive format such as rar, tar or zip" ;
    solveit-core:techniqueID "T1026" ;
    solveit-core:techniqueName "Writing data to standard archive format" .

