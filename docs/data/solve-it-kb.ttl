:techniqueT1001 a solveit-core:Technique ;
    rdfs:label "T1001: Triage"@en ;
    solveit-core:hasCASEInputClass "https://ontology.solveit-df.org/solveit/observable/DeviceSet"^^xsd:anyURI ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/PrioritizedDeviceSet"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1001,
        :weaknessW1002,
        :weaknessW1003 ;
    solveit-core:hasReference "Roussev, V., Quates, C. and Martell, R., 2013. Real-time digital forensics and triage. Digital Investigation, 10(2), pp.158-167.",
        "Wilson-Kovacs, D., 2020. Effective resource management in digital forensics: An exploratory analysis of triage practices in four English constabularies. Policing: an international journal, 43(1), pp.77-90." ;
    solveit-core:techniqueDescription "Digital forensic triage is a partial forensic examination conducted under (significant) time and resource constraints. (Roussev et al 2013)." ;
    solveit-core:techniqueDetails "Involves the ranking of apprehended digital items in terms of their importance to a case and likelihood that the contain the data require (Wilson-Kovacs 2020). It can involve multiple techniques to identify devices of most interest such as keyword searching, hash matching, media review etc." ;
    solveit-core:techniqueID "T1001" ;
    solveit-core:techniqueName "Triage" .

:techniqueT1002 a solveit-core:Technique ;
    rdfs:label "T1002: Disk imaging"@en ;
    solveit-core:hasCASEInputClass "https://ontology.solveit-df.org/solveit/observable/DeviceInterface"^^xsd:anyURI,
        "https://ontology.solveit-df.org/solveit/observable/WriteProtectedDeviceInterface"^^xsd:anyURI ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/BitstreamData"^^xsd:anyURI ;
    solveit-core:hasExample "FTK Imager",
        "Magnet ACQUIRE",
        "dcfldd" ;
    solveit-core:hasPotentialWeakness :weaknessW1004,
        :weaknessW1006,
        :weaknessW1007,
        :weaknessW1013,
        :weaknessW1014,
        :weaknessW1015,
        :weaknessW1016,
        :weaknessW1136,
        :weaknessW1143 ;
    solveit-core:hasReference "Nikkel, B., 2016. Practical forensic imaging: securing digital evidence with Linux tools. No Starch Press, Chapter 6, “Forensic Image Acquisition" ;
    solveit-core:techniqueDescription "Copying of sectors from a storage media, typically LBA~0~ to LBA~max~ to a bitstream that can be stored in a image format (T1025). " ;
    solveit-core:techniqueDetails "The process could be applied to a traditional hard disk, SSD, USB stick, or data from an eMMC chip that has been desoldered and placed in a reader. This data needs to be stored as a container file (T1025). Logs would also usually be created recording the details of the imaging process and any errors that occured." ;
    solveit-core:techniqueID "T1002" ;
    solveit-core:techniqueName "Disk imaging" .

:techniqueT1003 a solveit-core:Technique ;
    rdfs:label "T1003: Memory imaging"@en ;
    solveit-core:hasCASEInputClass "https://ontology.unifiedcyberontology.org/uco/observable/Memory"^^xsd:anyURI ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/RawImageFile"^^xsd:anyURI,
        "https://ontology.solveit-df.org/solveit/observable/RawImageInfoFile"^^xsd:anyURI ;
    solveit-core:hasExample "FTK Imager" ;
    solveit-core:hasPotentialWeakness :weaknessW1029,
        :weaknessW1030,
        :weaknessW1031,
        :weaknessW1032,
        :weaknessW1033 ;
    solveit-core:hasReference "Case, A. and Richard III, G. G., 2017. Memory forensics: The path forward. Digital investigation, 20, 23-33.",
        "Kornblum, J.D., 2007. Using every part of the buffalo in Windows memory analysis. Digital Investigation, 4(1), pp.24-29.",
        "Latzo, T., Palutke, R. and Freiling, F., 2019. A universal taxonomy and survey of forensic memory acquisition techniques. Digital Investigation, 28, 56-69." ;
    solveit-core:hasSynonym "RAM dump",
        "RAM imaging",
        "memory dump" ;
    solveit-core:techniqueDescription "Involves creating a copy of the live memory data of a running system" ;
    solveit-core:techniqueDetails "Collection of Pagefile may also be useful (Kornblum 2007)." ;
    solveit-core:techniqueID "T1003" ;
    solveit-core:techniqueName "Memory imaging" .

:techniqueT1004 a solveit-core:Technique ;
    rdfs:label "T1004: Selective file acquisition"@en ;
    solveit-core:hasCASEInputClass "https://ontology.unifiedcyberontology.org/uco/observable/FileSystem"^^xsd:anyURI ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/FilteredFileSet"^^xsd:anyURI,
        "https://ontology.solveit-df.org/solveit/observable/ForensicImageContainer"^^xsd:anyURI ;
    solveit-core:hasExample "FTK Imager - allows an AD1 logical container to be created of a selected subset of files within a previewed data source." ;
    solveit-core:hasPotentialWeakness :weaknessW1017,
        :weaknessW1018,
        :weaknessW1019,
        :weaknessW1020,
        :weaknessW1021,
        :weaknessW1022,
        :weaknessW1023,
        :weaknessW1024 ;
    solveit-core:hasSynonym "Logical imaging" ;
    solveit-core:techniqueDescription "Previewing a data source and selecting a subset of the files for extraction into a container such as a tar/zip file or a forensic image format." ;
    solveit-core:techniqueID "T1004" ;
    solveit-core:techniqueName "Selective file acquisition" .

:techniqueT1005 a solveit-core:Technique ;
    rdfs:label "T1005: Conduct a search of a crime scene"@en ;
    solveit-core:hasCASEOutputClass "https://ontology.solveit-df.org/solveit/observable/DeviceSet"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/Device"^^xsd:anyURI,
        "https://ontology.unifiedcyberontology.org/uco/observable/location"^^xsd:anyURI ;
    solveit-core:hasPotentialWeakness :weaknessW1114 ;
    solveit-core:hasReference "Birzer, M.L., 2018. Crime Scene Search. Introduction to Criminal Investigation, p.35.",
        "Forensic Science Regulator (2025) Incident scene examination (FSR-GUI-0006). GOV.UK. Available at: https://www.gov.uk/government/publications/incident-scene-examination-fsr-gui-0006" ;
    solveit-core:hasSynonym "Crime scene examination",
        "Crime scene investigation",
        "Crime scene processing",
        "Incident scene examination",
        "Scene search" ;
    solveit-core:techniqueDescription "The process of 'carefully documenting the conditions at a crime scene and identifying all relevant physical evidence.' (Birzer 2018)." ;
    solveit-core:techniqueDetails "The UK's Forensic Science Regulator (FSR) guidance refers to \"Incident scene examination\" which takes a holistic approach and considers an incident scene in conjunction with the requirements of an investigation and the criminal justice system. The aim of incident scene examination is to identify and locate, or note the absence of, physical material which has relevance and significance to inform the investigation including, where relevant, the reconstruction of past events." ;
    solveit-core:techniqueID "T1005" ;
    solveit-core:techniqueName "Conduct a search of a crime scene" .

:techniqueT1008 a solveit-core:Technique ;
    rdfs:label "T1008: Profiling network traffic"@en ;
    solveit-core:techniqueID "T1008" ;
    solveit-core:techniqueName "Profiling network traffic" .

