@prefix : <https://ontology.solveit-df.org/solveit/examples/> .
@prefix solveit-core: <https://ontology.solveit-df.org/solveit/core/> .
@prefix solveit-observable: <https://ontology.solveit-df.org/solveit/observable/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@base <https://ontology.solveit-df.org/solveit/examples/> .

#################################################################
#    SOLVE-IT Examples
#    Example instances demonstrating the use of SOLVE-IT classes
#################################################################

<https://ontology.solveit-df.org/solveit/examples> rdf:type owl:Ontology ;
    owl:versionIRI <https://ontology.solveit-df.org/solveit/examples/1.0.0> ;
    owl:imports <https://ontology.solveit-df.org/solveit/core> ;
    rdfs:label "SOLVE-IT Examples"@en ;
    rdfs:comment "Example instances demonstrating the SOLVE-IT ontology usage."@en .

#################################################################
#    Example VideoFrame Instance
#################################################################

:exampleFrame001 rdf:type solveit-observable:VideoFrame ;
    rdfs:label "Frame 001 from surveillance video"@en ;
    solveit-observable:videoFrameNumber 1250 ;
    solveit-observable:videoFramePixelWidth 1920 ;
    solveit-observable:videoFramePixelHeight 1080 ;
    solveit-observable:extractedFromVideo :video001 .

:video001 rdf:type uco-observable:File ;
    rdfs:label "surveillance_camera_01.mp4"@en .

#################################################################
#    Example SOLVE-IT Technique Instance
#################################################################

:techniqueT1002 rdf:type solveit-core:Technique ;
    rdfs:label "T1002: Disk imaging"@en ;
    solveit-core:techniqueID "T1002" ;
    solveit-core:techniqueName "Disk imaging" ;
    solveit-core:techniqueDescription "Copying of sectors from a storage media, typically LBA~0~ to LBA~max~ into an imaging format. The could be from a traditional hard disk, SSD, USB stick, or data from an eMMC chip that has been desoldered and placed in a reader." ;
    solveit-core:hasExample "dcfldd" ;
    solveit-core:hasExample "FTK Imager" ;
    solveit-core:hasExample "Magnet ACQUIRE" ;
    solveit-core:hasPotentialWeakness :weaknessW1004 ;
    solveit-core:techniqueCASEOutputClass "https://ontology.unifiedcyberontology.org/uco/observable/Image"^^xsd:anyURI ;
    solveit-core:hasReference "Nikkel, B., 2016. Practical forensic imaging: securing digital evidence with Linux tools. No Starch Press, Chapter 6, 'Forensic Image Acquisition'" .

#################################################################
#    Example SOLVE-IT Weakness Instance
#################################################################

:weaknessW1004 rdf:type solveit-core:Weakness ;
    rdfs:label "W1004: Acquisition does not include all sectors from LBA0 to LBA max"@en ;
    solveit-core:weaknessID "W1004" ;
    solveit-core:weaknessName "Acquisition does not include all sectors from LBA0 to LBA max" ;
    solveit-core:weaknessINCOMP "x" ;
    solveit-core:weaknessINAC_EX "" ;
    solveit-core:weaknessINAC_AS "" ;
    solveit-core:weaknessINAC_ALT "" ;
    solveit-core:weaknessINAC_COR "" ;
    solveit-core:weaknessMISINT "" ;
    solveit-core:hasPotentialMitigation :mitigationM1003 ;
    solveit-core:hasPotentialMitigation :mitigationM1004 .

#################################################################
#    Example SOLVE-IT Mitigation Instances
#################################################################

:mitigationM1003 rdf:type solveit-core:Mitigation ;
    rdfs:label "M1003: Check image size corresponds with drive label"@en ;
    solveit-core:mitigationID "M1003" ;
    solveit-core:mitigationName "Check image size corresponds with drive label" .

:mitigationM1004 rdf:type solveit-core:Mitigation ;
    rdfs:label "M1004: Check hash of image matches hash of source device"@en ;
    solveit-core:mitigationID "M1004" ;
    solveit-core:mitigationName "Check hash of image matches hash of source device" .

#################################################################
#    Example UnlockPattern Instance
#################################################################

:unlockPattern001 rdf:type solveit-observable:UnlockPattern ;
    rdfs:label "Android unlock pattern from seized device"@en ;
    solveit-observable:unlockPatternSequence (1 4 7 8 9) ;
    rdfs:comment "Pattern extracted from /data/system/gesture.key representing an 'L' shape on 3x3 grid (down left column, across bottom row)."@en .
